# Copie para ".env" na mesma pasta e preencha com valores reais.
# NUNCA suba o .env para o Git ou qualquer compartilhamento.
#
# Os dados de cada empresa/CNPJ (certificado incluido) NAO ficam aqui - ficam
# em "empresas.json" (copie de "empresas.example.json"). Isso porque uma
# execucao pode ter varias empresas, cada uma com seu proprio certificado.

# Ambiente: "producao" ou "homologacao" (use homologacao/producao restrita para
# testar antes de rodar contra a producao de verdade). Vale para todas as
# empresas na mesma execucao.
AMBIENTE=homologacao

# Pasta onde os XMLs capturados serao organizados (cnpj/ano/mes/tipo). Por
# padrao usa a subpasta "dados" deste projeto.
PASTA_SAIDA=./dados

# --- Sankhya (opcional, usado so para cruzar/conferir notas ja conhecidas no ERP) ---
SANKHYA_BASE_URL=https://api.sankhya.com.br
SANKHYA_CLIENT_ID=coloque_aqui_o_client_id
SANKHYA_CLIENT_SECRET=coloque_aqui_o_client_secret
SANKHYA_TOKEN=coloque_aqui_o_x_token
