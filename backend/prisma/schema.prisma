model DeletionRequest {
  id         String                @id @default(uuid())
  targetType DeletionTargetType
  targetId   String
  reason     String?
  status     DeletionRequestStatus @default(PENDING)

  requestedById String
  reviewedById  String?

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  requestedBy User  @relation("DeletionRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("DeletionReviewedBy", fields: [reviewedById], references: [id])

  @@index([targetType])
  @@index([targetId])
  @@index([status])
  @@index([requestedById])
  @@index([reviewedById])
}

enum TaxRegimeType {
  SIMPLES
  PRESUMIDO
  REAL
}

enum RevenueSource {
  MANUAL
  IMPORTED_XML
}

// Configuração do regime tributário de uma loja, com vigência — importante
// porque o mesmo estabelecimento pode migrar de regime ao longo do tempo
// (ex: Presumido → Real). O cálculo de um mês sempre usa a configuração
// vigente naquele referenceMonth, nunca a mais recente cadastrada. As
// alíquotas ficam todas configuráveis (não fixas no código) porque mudam
// por legislação e porque cada loja pode ter enquadramento diferente —
// devem ser conferidas com o contador antes de usar pra guiar pagamento.
model TaxRegimeConfig {
  id String @id @default(uuid())

  storeId       String
  regime        TaxRegimeType
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = vigente até um novo registro substituir

  // Simples Nacional (Anexo I — comércio, caso de bares/restaurantes)
  simplesAnexo String? // ex: "I"

  // Lucro Presumido
  presumidoIrpjPercent      Decimal? @db.Decimal(5, 2) // base de presunção IRPJ (ex: 8.00 ou 32.00)
  presumidoCsllPercent      Decimal? @db.Decimal(5, 2) // base de presunção CSLL (ex: 12.00 ou 32.00)
  presumidoPisCofinsPercent Decimal? @db.Decimal(5, 2) // cumulativo (ex: 3.65)

  // Lucro Real
  realPisCofinsPercent Decimal? @db.Decimal(5, 2) // não-cumulativo (ex: 9.25)

  // ICMS — comum a Presumido/Real (no Simples já vai embutido no DAS)
  icmsRegimeEspecialMg Boolean  @default(false) // regime especial bares/restaurantes (RICMS/MG art. 75, XXXIX)
  icmsAliquotaRefeicao Decimal? @db.Decimal(5, 2) // ex: 3.00 (regime especial)
  icmsAliquotaOutras   Decimal? @db.Decimal(5, 2) // ex: 4.00 (regime especial)
  icmsAliquotaPadrao   Decimal? @db.Decimal(5, 2) // ex: 18.00 (sem regime especial)

  notes String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User  @relation("TaxRegimeConfigCreatedBy", fields: [createdById], references: [id])

  @@index([storeId])
  @@index([effectiveFrom])
}

// Faturamento (receita bruta) por loja e período — hoje lançado manualmente;
// preparado pra futuramente ser preenchido automaticamente por importação de
// XML de venda (campo source vira IMPORTED_XML nesse caso). É o dado que
// falta pro purchases sozinho pra calcular qualquer regime tributário de
// verdade (Simples, Presumido e Real dependem de receita, não só de compra).
model RevenueEntry {
  id String @id @default(uuid())

  storeId        String
  referenceMonth String // "2026-08"
  grossRevenue   Decimal       @db.Decimal(12, 2)
  source         RevenueSource @default(MANUAL)
  notes          String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User  @relation("RevenueEntryCreatedBy", fields: [createdById], references: [id])

  @@unique([storeId, referenceMonth])
  @@index([storeId])
}

// ============================================================
// Integração Meep (API Sales API Third) — puxa vendas, itens, CFOP/NCM
// e transações de pagamento pra conciliação de caixa, loja por loja.
//
// Hoje só a loja Contagem tem credencial preenchida, mas o cadastro já
// existe (vazio) pra Anchieta e Raiz poderem ser ligadas depois sem
// precisar de mudança de schema — é só a tela em Cadastros → Lojas
// preencher a credencial daquela loja quando chegar a hora.
//
// Tudo que a Meep devolve é gravado localmente (incluindo o JSON bruto de
// cada pedido/transação, em rawJson) antes de qualquer tela ser montada
// em cima — segue a própria recomendação da Meep de nunca rebuscar a
// mesma venda duas vezes, e garante que a gente nunca perde um dado só
// porque decidiu exibir a tela de um jeito diferente depois.
// ============================================================

// Credencial da API Meep por loja. Subscription key e senha nunca ficam em
// texto puro — mesmo padrão AES-256-GCM já usado pro certificado digital
// (certificate-crypto.util.ts, chave CERT_ENCRYPTION_KEY no .env).
model MeepCredential {
  id      String @id @default(uuid())
  storeId String @unique

  // Primary key (ou secondary key) da assinatura criada pelo administrador
  // Meep pro seu usuário, vista na aba "Profile" do developer portal.
  subscriptionKeyCipher  String
  subscriptionKeyIv      String
  subscriptionKeyAuthTag String

  // Login do portal https://portal.meep-app.com/ (não é o e-mail/senha do
  // Developer Portal, que só serve pra gerenciar a assinatura).
  username String

  passwordCipher  String
  passwordIv      String
  passwordAuthTag String

  // storeId que a MEEP usa pra identificar esse ponto de venda — é
  // diferente do id interno da nossa tabela Store, por isso fica gravado
  // à parte (o usuário já recebe esse valor pronto da Meep).
  meepStoreId String

  // Liga/desliga a sincronização automática sem precisar apagar a
  // credencial — útil pra pausar uma loja (ex: problema na Meep) sem
  // perder a configuração já feita.
  active Boolean @default(true)

  // Cursor de até onde já sincronizamos cada rota (fim da última janela
  // processada com sucesso) — o cron sempre continua daqui, nunca
  // reconsulta um período já trazido. Nulo = nunca sincronizado ainda.
  lastSalesSyncedUntil        DateTime?
  lastConciliationSyncedUntil DateTime?

  // Dia comercial (YYYY-MM-DD) mais recente já "confirmado" pela rotina de
  // D+1 (ver dailyConfirmSync em meep-sync.service.ts) — a Meep só fecha os
  // dados de um dia por completo algum tempo depois da virada, então o dia
  // anterior fica marcado como "Aguardando informação" no Venda/Lista até
  // essa confirmação rodar (algumas vezes, de manhã) e preencher este
  // campo. Comparação lexicográfica funciona direto (formato YYYY-MM-DD).
  lastDailyConfirmedBusinessDay String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Histórico de cada tentativa de sincronização (sucesso ou erro) — mesmo
// padrão do SefazSyncLog, dá visibilidade de quando algo falhou sem
// ninguém precisar ficar olhando toda hora.
model MeepSyncLog {
  id      String @id @default(uuid())
  storeId String

  // 'SALES' | 'SIMPLE_SALES' | 'CONCILIATION'
  endpoint String

  rangeStart DateTime
  rangeEnd   DateTime

  success             Boolean
  message             String
  ordersFetched       Int     @default(0)
  transactionsFetched Int     @default(0)

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, endpoint, createdAt])
}

// Pedido de venda trazido da Meep (GetSales, enriquecido por
// GetSimpleSales quando disponível) — é o header; itens e pagamentos ficam
// em tabelas próprias. rawJson guarda a resposta bruta desse pedido
// específico, pra nunca perder nada mesmo que a gente ainda não tenha
// mapeado algum campo novo pra coluna própria.
model MeepOrder {
  id      String @id @default(uuid())
  storeId String

  meepOrderId   String
  meepAccountId String?
  orderType     Int?
  orderDateUtc  DateTime

  statusCode Int?
  status     String?

  customerDocument    String?
  customerName        String?
  customerEmail       String?
  customerPhoneNumber String?
  customerIdentifier  String?

  paymentType   Int?
  posCode       String?
  posMacAddress String?
  cashierId     String?

  discount Decimal @default(0) @db.Decimal(12, 2)
  value    Decimal @db.Decimal(12, 2)

  // De qual rota esse pedido veio da última vez que foi atualizado —
  // 'SALES' (tem CFOP/NCM) ou 'SIMPLE_SALES' (tem pagamentos detalhados).
  lastSyncedFrom String

  rawJson Json

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items    MeepOrderItem[]
  payments MeepOrderPayment[]

  @@unique([storeId, meepOrderId])
  @@index([storeId, orderDateUtc])
}

// Item vendido dentro de um pedido Meep — inclui CFOP/NCM quando veio da
// rota GetSales (é a única que traz esses dois campos fiscais).
model MeepOrderItem {
  id      String @id @default(uuid())
  orderId String

  meepItemId  String?
  productId   String
  productType Int?
  productName String

  quantity  Decimal  @db.Decimal(12, 3)
  unitValue Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  addition  Decimal  @default(0) @db.Decimal(12, 2)
  insurance Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal? @db.Decimal(12, 2)

  ncm  String?
  cfop String?

  order MeepOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Pagamento associado a um pedido Meep (crédito/débito/dinheiro/PIX/etc.),
// vindo da rota GetSimpleSales — é a única que detalha NSU, autorização e
// bandeira por pagamento dentro do próprio pedido.
model MeepOrderPayment {
  id      String @id @default(uuid())
  orderId String

  meepPaymentId       String?
  typeId              Int?
  type                String?
  value               Decimal   @db.Decimal(12, 2)
  receiptDate         DateTime?
  nsu                 String?
  authorizationNumber String?
  cardBannerName      String?

  order MeepOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Transação de pagamento pra conciliação de caixa (rota
// GetTransactionsForConciliation) — traz valor bruto, taxa e valor
// líquido por transação, além do tipo de pagamento e bandeira. Não tem
// FK direta pra MeepOrder porque a Meep nem sempre garante que o
// OrderId bate 1:1 (ex: split de pagamento); o vínculo por meepOrderId
// é feito na hora de exibir, não estruturalmente.
model MeepConciliationTransaction {
  id      String @id @default(uuid())
  storeId String

  meepTransactionId String  @unique
  meepOrderId       String?

  createdOn   DateTime
  createdOnBr String?

  authorizationNumber String?
  grossValue          Decimal   @db.Decimal(12, 2)
  ratePercentage      Decimal?  @db.Decimal(7, 4)
  rateValue           Decimal?  @db.Decimal(12, 2)
  rateValueAdvance    Decimal?  @db.Decimal(12, 2)
  netValue            Decimal   @db.Decimal(12, 2)
  dueDate             DateTime?
  installments        Int?

  paymentTypeId   Int?
  paymentTypeName String?
  cardFlagId      Int?
  cardFlagName    String?
  pointOfSaleName String?

  rawJson Json

  syncedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdOn])
}

// Lançamento manual por dia comercial pra complementar a conciliação de
// caixa automática da Meep (Credito/Debito/PIX/Dinheiro, que já vem da
// MeepConciliationTransaction) — ver meep-query.service.ts/
// CashConciliationTab.tsx. businessDay usa o mesmo formato "AAAA-MM-DD"
// do resto da ponte Meep (ver business-day.util.ts), não DateTime, pra
// bater exatamente com o agrupamento por dia comercial (08h-04h) que a
// tela já usa.
model MeepCashExtra {
  id      String @id @default(uuid())
  storeId String

  businessDay String

  freelancer Decimal @default(0) @db.Decimal(10, 2)
  descontos  Decimal @default(0) @db.Decimal(10, 2)
  outros     Decimal @default(0) @db.Decimal(10, 2)
  vale       Decimal @default(0) @db.Decimal(10, 2)

  // Linha "editável" da grade de Conciliação de Caixa: vem pré-preenchida
  // com o valor que a Meep calculou (Credito/Debito/Pix/Dinheiro), mas o
  // usuário pode corrigir se encontrar um valor diferente — o que for
  // salvo aqui passa a ser o valor "oficial" do sistema pra aquele dia.
  // Null = usuário nunca editou esse dia ainda (tela mostra o valor
  // calculado da Meep como default, sem gravar nada até o primeiro Salvar).
  sistemaCredito  Decimal? @db.Decimal(10, 2)
  sistemaDebito   Decimal? @db.Decimal(10, 2)
  sistemaPix      Decimal? @db.Decimal(10, 2)
  sistemaDinheiro Decimal? @db.Decimal(10, 2)

  // Linha "Banco": o que de fato caiu na conta, por forma de pagamento —
  // sempre digitado manualmente (não existe fonte automática pra isso).
  // Null = ainda não preenchido.
  bancoCredito  Decimal? @db.Decimal(10, 2)
  bancoDebito   Decimal? @db.Decimal(10, 2)
  bancoPix      Decimal? @db.Decimal(10, 2)
  bancoDinheiro Decimal? @db.Decimal(10, 2)

  observacao String?

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("MeepCashExtraUpdatedBy", fields: [updatedById], references: [id])

  @@unique([storeId, businessDay])
  @@index([storeId])
}
