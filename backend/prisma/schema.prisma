generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATIVO
  COMPRADOR
  ESTOQUISTA
  GERENTE
  PROPRIETARIO
  FINANCEIRO
  // Perfil operacional do projeto reduzido: só vê/responde as próprias
  // tarefas e só acessa Perdas (sem Serviços). Adicionado à parte dos
  // perfis antigos (Comprador/Estoquista/Financeiro), que continuam
  // intactos pra quando o módulo de Compras voltar a ficar visível.
  FUNCIONARIO
}

// ATENÇÃO — migração em andamento (separação do estágio fiscal):
// WAITING_INVOICE, HAS_COUPON_ONLY, HAS_INVOICE e WAITING_PAYMENT_REGISTER
// estão DESCONTINUADOS. O código novo não escreve mais nenhum deles — o
// estágio fiscal (nota/cupom) agora vive em Purchase.fiscalStatus (enum
// PurchaseFiscalStatus, abaixo). Eles continuam existindo aqui só porque o
// banco ainda tem linhas antigas gravadas com esses valores; o script
// backend/scripts/backfill-purchase-fiscal-status.ts migra essas linhas
// pra fiscalStatus + recalcula o status operacional correto. Só depois
// que ele rodar (e confirmarmos que não sobrou nenhuma linha com esses 4
// valores) é que dá pra removê-los do enum de verdade numa migração futura
// — remover agora, com linhas ainda usando esses valores, quebra a
// migração (Postgres não deixa trocar o tipo de uma coluna pra um enum
// que não cobre o valor que já está gravado).
enum PurchaseStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  REJECTED
  WAITING_RECEIPT
  RECEIVED_OK
  RECEIVED_WITH_DIFFERENCE
  /// @deprecated use fiscalStatus — mantido só pra linhas antigas ainda não migradas
  WAITING_INVOICE
  /// @deprecated use fiscalStatus — mantido só pra linhas antigas ainda não migradas
  HAS_COUPON_ONLY
  /// @deprecated use fiscalStatus — mantido só pra linhas antigas ainda não migradas
  HAS_INVOICE
  /// @deprecated nunca foi escrito pelo código — mantido só por segurança
  WAITING_PAYMENT_REGISTER
  CLOSED
  CANCELED
}

// Estágio fiscal (nota/cupom) da compra — separado de PurchaseStatus
// (estágio operacional) porque os dois são independentes: uma compra pode
// estar RECEIVED_OK (operacional) e ainda não ter nota (fiscal = PENDING)
// ao mesmo tempo. Antes disso, addFiscalDocument() sobrescrevia
// Purchase.status direto, o que "perdia" o RECEIVED_OK assim que uma nota
// era anexada (bug: botão "Fechar compra" ficava inalcançável depois de
// anexar NF, porque exigia status RECEIVED_OK e hasInvoice juntos, e o
// segundo sobrescrevia o primeiro).
enum PurchaseFiscalStatus {
  PENDING
  COUPON_ONLY
  INVOICE
}

enum PurchaseCategory {
  SUPPLIER_ORDER
  AVULSA_CARD
  ONLINE_MARKETPLACE
}

enum PurchaseOrigin {
  NORMAL
  WEBSITE
  MERCADO_LIVRE
  WHATSAPP
  PHONE
  STORE_COUNTER
  OTHER
}

enum PaymentMethod {
  CREDIT_CARD
  CASH
  PIX
  COMPANY_ACCOUNT
  BOLETO
}

// Marcação manual (não é calculada) pra dizer se a compra ainda precisa de
// uma conta a pagar (TO_PAY, padrão) ou se já foi paga de outra forma sem
// passar pelo módulo Contas a Pagar (PAID — ex: pago na hora com dinheiro
// do caixa, sem gerar conta nenhuma). Não confundir com PaymentMethod
// (como foi/será pago) nem com Bill.paid (se a conta a pagar em si já foi
// quitada) — esse campo é só pra saber se falta gerar a conta.
enum PurchasePaymentStatus {
  TO_PAY
  PAID
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FiscalDocumentType {
  COUPON
  INVOICE
}

enum FiscalDocumentStatus {
  LINKED
  REPLACED
  CANCELED
}

enum ReceiptStatus {
  OK
  MISSING_ITEMS
  EXTRA_ITEMS
  PARTIAL
}

enum BillStatus {
  OPEN
  PAID
  OVERDUE
  CANCELED
}

enum PayableType {
  BOLETO
  PIX
  CARD
  NO_BILL
}

enum PurchaseHistoryAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  COUPON_UPLOADED
  INVOICE_UPLOADED
  RECEIVED
  CLOSED
  BILL_CREATED
  BILL_PAID
  DELETION_REQUESTED
  PAYMENT_STATUS_CHANGED
}

enum ApprovalLevel {
  AUTO
  MANAGER
  OWNER
}

enum PurchaseAlertType {
  HIGH_VALUE
  MISSING_SUPPLIER
  WAITING_INVOICE
  REPEATED_SUPPLIER
  SUSPICIOUS_DESCRIPTION
  CARD_USAGE
  MISSING_RECEIPT
  BILL_OVERDUE
}

enum PurchaseAlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum NotificationType {
  PURCHASE_CREATED
  PURCHASE_APPROVED
  PURCHASE_REJECTED
  WAITING_APPROVAL
  WAITING_INVOICE
  WAITING_RECEIPT
  BILL_DUE_TODAY
  BILL_DUE_WEEK
  BILL_OVERDUE
  CRITICAL_ALERT
  DELETION_REQUESTED
  TASK_ASSIGNED
  TASK_OVERDUE
  TASK_CONFIRMED
  LOSS_ADDED
  SERVICE_ADDED
}

// Frequência de uma tarefa: diária/semanal/mensal geram uma nova ocorrência
// a cada ciclo; ocasional (ONCE) tem uma única ocorrência com data fixa.
enum TaskRecurrence {
  DAILY
  WEEKLY
  MONTHLY
  ONCE
}

enum TaskOccurrenceStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  DONE
  LATE
  CANCELLED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeletionTargetType {
  STORE
  PURCHASE
  PURCHASE_ITEM
  FISCAL_DOCUMENT
  BILL
  SUPPLIER
  ATTACHMENT
  CARD
}

enum BillPaymentMethod {
  BANK_SLIP
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  FLASH
  BANK_TRANSFER
  COMPANY_ACCOUNT
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
  EVP
}

// Forma de pagamento de prestadores de serviço e funcionários — contexto
// separado de PaymentMethod (compras) e BillPaymentMethod (contas a pagar),
// não misturar.
enum PayoutMethod {
  PIX
  DINHEIRO
  TRANSFERENCIA
  BOLETO
  OUTRO
}

enum EmployeePaymentType {
  ADIANTAMENTO
  PAGAMENTO
  VALE_TRANSPORTE
  PREMIACAO
  DECIMO_TERCEIRO
  FERIAS
  RESCISAO
  OUTRO
}

enum EmployeePaymentStatus {
  OPEN
  PAID
  CANCELED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(COMPRADOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Marca o dono real do sistema (só ele, sempre true) — dá acesso total
  // independente do perfil, e é o único que pode cadastrar/editar outro
  // usuário com perfil Proprietário. Não é um perfil (UserRole), é uma
  // flag à parte porque só uma pessoa deve ter isso, mesmo que existam
  // vários Proprietários.
  isAdminMaster Boolean @default(false)

  // Permissão extra e explícita pra aprovar/reprovar compras. Por padrão
  // só Comprador, Proprietário e Admin Master (isAdminMaster) aprovam —
  // essa flag libera aprovação pra qualquer outro usuário específico (ex.:
  // um Administrativo ou Gerente de confiança), sem mudar o perfil dele.
  // Só quem já pode aprovar por conta própria (Admin Master ou
  // Proprietário) pode marcar/desmarcar essa flag em outro usuário — ver
  // ensureCanGrantApprovalPermission em users.service.ts.
  canApprovePurchases Boolean @default(false)

  // Restrição extra de módulo por pessoa, além do que o perfil (role) já
  // libera e do que a loja tem habilitado (Store.enabledModules). Lista
  // vazia = sem restrição extra (usa só perfil + loja, comportamento de
  // sempre) — é o padrão, pra ninguém perder acesso quando esse campo
  // entrar no ar. Só fica restrito quando o Proprietário desmarca algum
  // módulo especificamente pra essa pessoa (Cadastros → Colaboradores).
  // Só o Proprietário (ou Admin Master) pode editar essa lista — ver
  // ensureCanGrantModuleAccess em users.service.ts.
  moduleAccess StoreModule[] @default([])

  // Dentro de Contas a Pagar, permissão específica pra ver o VALOR de
  // contas cuja categoria seja "Funcionários" ou "Freelancer" (folha de
  // pagamento lançada manualmente por lá) — quem não tem essa flag nem
  // vê essas contas na lista, não só o valor escondido. Default true pra
  // não tirar acesso de ninguém quando o campo entrar no ar; só o
  // Proprietário (ou Admin Master) pode desmarcar pra alguém — mesma
  // regra de moduleAccess acima.
  canViewPayrollBills Boolean @default(true)

  // Controla quem pode MEXER em permissões de outros colaboradores (role,
  // canApprovePurchases, moduleAccess, canViewPayrollBills e esse próprio
  // campo) — sem essa flag marcada, a pessoa nem vê a seção de permissões
  // na tela de edição de ninguém, mesmo sendo Proprietário. Default false
  // de propósito: ninguém ganha esse poder sozinho. Só o Admin Master pode
  // marcar/desmarcar essa flag em alguém — ver
  // ensureCanGrantPermissionsManagement em users.service.ts.
  canManagePermissions Boolean @default(false)

  // Conta criada pelo autocadastro público de teste (/demo/signup, loja
  // isDemo=true). demoExpiresAt é o prazo (1h a partir do cadastro) —
  // depois disso login e qualquer request autenticada passam a ser
  // recusados (ver auth.service.ts e jwt.strategy.ts), mesmo relogando.
  // signupIp guarda o IP de quem se cadastrou, só pra impedir que o mesmo
  // IP fique criando conta nova pra ganhar teste de novo.
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?
  signupIp      String?

  // Login passou a ser por TELEFONE + senha (o e-mail vira só canal de
  // recuperação de senha). Formato livre no cadastro, mas é normalizado
  // (só dígitos, com DDI 55) antes de comparar/enviar/logar. Único porque
  // tanto o login quanto a resposta que chega no webhook do WhatsApp
  // precisam achar exatamente uma pessoa.
  phone String? @unique

  // Fluxo de ativação de conta: quando um usuário é cadastrado sem senha
  // (cadastro "de verdade", pelo WhatsApp), fica accountActivated=false
  // até a pessoa criar a própria senha pelo link único recebido no
  // WhatsApp (ver activationToken). Contas antigas e qualquer cadastro
  // feito já com senha nascem accountActivated=true (não passam por esse
  // fluxo). Enquanto accountActivated=false, login é bloqueado mesmo que
  // alguém tente adivinhar a senha-placeholder.
  accountActivated         Boolean   @default(true)
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?

  // Fluxo de "esqueci minha senha": token de uso único, gerado quando a
  // pessoa pede o link (por WhatsApp ou e-mail) em /esqueci-senha. Expira
  // em 1h (bem mais curto que o de ativação) e é limpo assim que a senha
  // é trocada ou quando um novo link é pedido antes do antigo expirar.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  // Quem tem essa flag marcada recebe um WhatsApp toda vez que um
  // fornecedor confirma um pedido de cotação (ver
  // QUOTATION_ORDER_CONFIRMED_EVENT em common/events.ts) — separado do
  // envio pro próprio fornecedor, é o aviso interno "fulano confirmou".
  // Pode marcar mais de uma pessoa; exige `phone` cadastrado pra
  // realmente receber (sem telefone, fica marcado mas não manda nada).
  notifyQuotationConfirmed Boolean @default(false)

  // Multi-tenant (venda pra outras empresas): qual empresa esse usuário
  // pertence. Fica opcional DE PROPÓSITO, pra sempre (não é um "nasce nulo,
  // depois preenche" como Store.empresaId abaixo) — toda conta comum tem
  // isso preenchido (rodou o backfill, ver
  // prisma/scripts/backfill-empresa-nugalho.ts), mas Admin Master
  // (isAdminMaster=true) continua com empresaId nulo indefinidamente: ele
  // não é "de" nenhuma empresa específica, gerencia todas pelo painel
  // /admin. Por isso esse campo não pode virar NOT NULL como Store.empresaId.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  userStores UserStore[]

  purchasesCreated            Purchase[] @relation("PurchaseCreatedBy")
  purchasesUpdated            Purchase[] @relation("PurchaseUpdatedBy")
  purchasesChecked            Purchase[] @relation("PurchaseCheckedBy")
  purchasesClosed             Purchase[] @relation("PurchaseClosedBy")
  purchasesApproved           Purchase[] @relation("PurchaseApprovedBy")
  invoiceResponsiblePurchases Purchase[] @relation("PurchaseInvoiceResponsible")

  receipts                    PurchaseReceipt[]
  approvals                   Approval[]
  purchaseHistories           PurchaseHistory[]
  fiscalDocuments             FiscalDocument[]
  billsLaunched               Bill[]               @relation("BillLaunchedBy")
  billRecorrenciasCreated     BillRecorrencia[]    @relation("BillRecorrenciaCreatedBy")
  cashReconciliationsLaunched CashReconciliation[] @relation("CashReconciliationLaunchedBy")
  meepCashExtrasUpdated       MeepCashExtra[]      @relation("MeepCashExtraUpdatedBy")
  notifications               Notification[]
  servicesCreated             Service[]            @relation("ServiceCreatedBy")
  certificatesUploaded        StoreCertificate[]   @relation("StoreCertificateUploadedBy")

  employeesCreated        Employee[]        @relation("EmployeeCreatedBy")
  employeePaymentsCreated EmployeePayment[] @relation("EmployeePaymentCreatedBy")

  deletionRequestsCreated  DeletionRequest[] @relation("DeletionRequestedBy")
  deletionRequestsReviewed DeletionRequest[] @relation("DeletionReviewedBy")

  paymentBatchConfigsUpdated PaymentBatchConfig[]
  quotationsCreated          Quotation[]          @relation("QuotationCreatedBy")

  taxRegimeConfigsCreated  TaxRegimeConfig[] @relation("TaxRegimeConfigCreatedBy")
  revenueEntriesCreated    RevenueEntry[]    @relation("RevenueEntryCreatedBy")
  outgoingSalesNfsImported OutgoingSalesNf[] @relation("OutgoingSalesNfImportedBy")

  freelancersCreated        Freelancer[]        @relation("FreelancerCreatedBy")
  freelancerPaymentsCreated FreelancerPayment[] @relation("FreelancerPaymentCreatedBy")

  tasksCreated             Task[]           @relation("TaskCreatedBy")
  tasksAssigned            Task[]           @relation("TaskAssignedTo")
  taskOccurrencesConfirmed TaskOccurrence[] @relation("TaskOccurrenceConfirmedBy")
  taskOccurrencesCancelled TaskOccurrence[] @relation("TaskOccurrenceCancelledBy")

  productLossesReported ProductLoss[]  @relation("ProductLossReportedBy")
  lossNfesCreated       LossNfe[]      @relation("LossNfeCreatedBy")
  devolucaoNfesCreated  DevolucaoNfe[] @relation("DevolucaoNfeCreatedBy")

  productSalesImportsImported ProductSalesImport[] @relation("ProductSalesImportImportedBy")

  stockMovementsCreated      StockMovement[]      @relation("StockMovementCreatedBy")
  productionMovementsCreated ProductionMovement[] @relation("ProductionMovementCreatedBy")

  pushSubscriptions PushSubscription[]
  whatsappMessages  WhatsappOutboundMessage[]
}

// Inscrição de push notification (Web Push) do navegador/PWA de um
// usuário. Um mesmo usuário pode ter várias (celular + notebook, por
// exemplo). "endpoint" é único por navegador/dispositivo — reinstalar o
// PWA ou limpar dados do site gera um endpoint novo.
model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

// Multi-tenant: cada Empresa é um cliente diferente do sistema (ex.: hoje só
// existe a "Nugalho", mas o sistema pode ser vendido pra outro dono com o
// próprio conjunto de lojas, fornecedores e usuários). Adicionado depois de
// o sistema já rodar com dados reais, então:
// - Store.empresaId e User.empresaId nasceram opcionais (migração 1, sem
//   quebrar nada) — prisma/scripts/backfill-empresa-nugalho.ts preencheu
//   todo mundo com a empresa "Nugalho" (a única que existia até então).
// - Confirmado que o backfill rodou certo, a migração 2 tornou
//   Store.empresaId obrigatório (toda loja tem que ter uma empresa dona).
//   User.empresaId continua opcional de propósito — ver comentário no
//   campo, no model User (é o Admin Master que fica sem empresa).
// - Isolamento de dado entre empresas hoje só está garantido pra Lojas e
//   Usuários (única e exclusivamente o que essa fase resolve) — cadastros
//   compartilhados como Fornecedor/Categoria de Fornecedor ainda são
//   globais (mesma lista pra todo mundo) até uma fase seguinte cuidar
//   deles. Ver docs/KNOWN_ISSUES.md.
model Empresa {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Observação livre do Admin Master sobre essa empresa-cliente (situação
  // de pagamento, combinado comercial, etc.) — não aparece pra ninguém da
  // própria empresa, só no painel /admin.
  adminNotes String?

  stores Store[]
  users  User[]

  // Fase de isolamento multi-tenant que faltava (fornecedor, categoria de
  // fornecedor, categoria de conta a pagar e config de lote bancário eram
  // globais — qualquer empresa via/editava dado de outra). Ver comentário
  // em cada model. Nascem opcionais (mesmo esquema de 2 migrações usado em
  // Store.empresaId): 1ª migração adiciona a coluna nullable + roda
  // backfill pra empresa "Nugalho"; só depois, confirmado o backfill, uma
  // 2ª migração torna obrigatório.
  suppliers           Supplier[]
  supplierCategories  SupplierCategory[]
  billCategories      BillCategory[]
  paymentBatchConfigs PaymentBatchConfig[]
}

model Store {
  id      String  @id @default(uuid())
  name    String
  cnpj    String?
  address String?
  phone   String?
  active  Boolean @default(true)

  // Loja "pessoal" do proprietário — não é uma empresa-cliente separada,
  // continua dentro da mesma Empresa (empresaId abaixo), só que marcada
  // como Física: controla as contas do próprio proprietário (ex: contas
  // de casa), não do negócio. Nasce com enabledModules restrito só a
  // CONTAS_A_PAGAR e o frontend colapsa o menu dela pra Dashboard +
  // Contas a Pagar, igual fizemos no Controle Rota.
  tipoPessoa TipoPessoaStore @default(JURIDICA)
  cpf        String?

  // Telefone (E.164 só dígitos, DDI 55) que recebe aviso diário via
  // WhatsApp das contas com vencimento hoje dessa loja. Em branco = não
  // manda aviso automático. Reaproveita o módulo WhatsApp já existente.
  telefoneAvisoDiario String?

  // Multi-tenant: de qual empresa-cliente essa loja é. Obrigatório — toda
  // loja tem uma empresa dona (rodou o backfill antes dessa migração
  // tornar o campo NOT NULL, ver comentário em cima do model Empresa).
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  // Loja de demonstração pública (ex: AMS) — usada como destino do
  // autocadastro de teste (/demo/signup). Só pode existir uma marcada
  // assim por vez (o código sempre usa a primeira que achar); serve pra
  // isolar quem está só testando o sistema dos dados reais das outras
  // lojas.
  isDemo Boolean @default(false)

  // Sigla da UF (ex: SP, MG) — exigida pelo webservice NFeDistribuicaoDFe
  // (campo cUFAutor) pra buscar as NF-e de mercadoria automaticamente.
  uf String?

  // Endereço estruturado + Inscrição Estadual — não usado pra nada além de
  // emitir NF-e própria (bloco <emit>/<enderEmit> exige endereço em campos
  // separados, com código IBGE do município, não endereço livre). Ficam em
  // branco até serem preenchidos manualmente em Cadastros → Lojas.
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  municipio           String?
  codigoMunicipioIbge String?
  cep                 String?
  inscricaoEstadual   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases           Purchase[]
  userStores          UserStore[]
  cards               Card[]
  approvalRules       ApprovalRule[]
  bills               Bill[]
  cashReconciliations CashReconciliation[]
  services            Service[]
  certificate         StoreCertificate?
  incomingServiceNfs  IncomingServiceNf[]
  incomingGoodsNfs    IncomingGoodsNf[]
  outgoingSalesNfs    OutgoingSalesNf[]
  employees           Employee[]
  taxRegimeConfigs    TaxRegimeConfig[]
  revenueEntries      RevenueEntry[]
  freelancers         Freelancer[]
  freelancerPayments  FreelancerPayment[]
  tasks               Task[]
  productLosses       ProductLoss[]
  sefazSyncLogs       SefazSyncLog[]
  lossNfes            LossNfe[]
  devolucaoNfes       DevolucaoNfe[]

  // Numeração própria da série de NF-e de baixa por perda (Nota de
  // Débito, finNFe=6/tpNFDebito=07 — Ajuste SINIEF 49/2025), separada da
  // série que o PDV já usa nas vendas pra nunca colidir. Fica em branco
  // até alguém configurar em Cadastros → Lojas antes da primeira emissão
  // de verdade; enquanto isso as emissões só valem pro ambiente de
  // homologação (sem valor fiscal).
  lossNfeSerie      Int?
  lossNfeNextNumber Int?

  // Mesma lógica acima, mas pra série própria da NF-e de devolução
  // (finNFe=4) — também separada da série de venda do PDV.
  devolucaoNfeSerie      Int?
  devolucaoNfeNextNumber Int?

  // Quais telas/funcionalidades essa loja enxerga — controle de módulos do
  // SaaS. Só quem tem isAdminMaster edita isso (painel /admin/modules); o
  // Proprietário/Administrativo da própria loja não vê nem muda. Lojas
  // novas nascem com tudo ligado (default abaixo) — é uma lista negativa
  // na prática: você desliga só o que aquele cliente não contratou.
  enabledModules StoreModule[] @default([COMPRAS, NOTAS_FISCAIS, SERVICOS, TRIBUTOS, PERDAS, CONTAS_A_PAGAR, TAREFAS, RELATORIOS, FUNCIONARIOS, FREELANCERS, PRODUTOS, ESTOQUE, COTACAO])

  productSalesImports       ProductSalesImport[]
  productRecipeItems        ProductRecipeItem[]
  recipeImportBackup        ProductRecipeImportBackup?
  stockItems                StockItem[]
  stockMovements            StockMovement[]
  stockSupplierItemMappings StockSupplierItemMapping[]
  productionItems           ProductionItem[]
  productionMovements       ProductionMovement[]

  quotationScheduleEntries QuotationScheduleEntry[]
  quotations               Quotation[]
  supplierStores           SupplierStore[]
  quotationCategoryItems   QuotationCategoryItem[]

  meepCredential               MeepCredential?
  meepOrders                   MeepOrder[]
  meepConciliationTransactions MeepConciliationTransaction[]
  meepSyncLogs                 MeepSyncLog[]
  meepCashExtras               MeepCashExtra[]

  billRecorrencias BillRecorrencia[]
}

// JURIDICA = loja normal de negócio (padrão). FISICA = loja pessoal do
// próprio proprietário dentro da mesma Empresa (ver comentário em
// Store.tipoPessoa) — usa CPF em vez de CNPJ e tem o menu restrito a
// Dashboard + Contas a Pagar.
enum TipoPessoaStore {
  JURIDICA
  FISICA
}

// Módulos que podem ser ligados/desligados por loja (painel restrito ao
// isAdminMaster). Cada valor aqui corresponde a um grupo de telas do menu
// (ver frontend/lib/menu.ts) — Cadastros, Início, Dashboard, Ajuda e
// Alertas/Notificações não entram porque são estrutura do sistema, não
// "produto contratável".
enum StoreModule {
  COMPRAS
  NOTAS_FISCAIS
  SERVICOS
  TRIBUTOS
  PERDAS
  CONTAS_A_PAGAR
  TAREFAS
  RELATORIOS
  FUNCIONARIOS
  FREELANCERS
  PRODUTOS
  ESTOQUE
  COTACAO
  // Antes dividia o mesmo controle de CONTAS_A_PAGAR (Contas a Pagar e
  // Conciliação de Caixa liberavam juntas) — separado pra dar um
  // quadradinho próprio pra Conciliação de Caixa em Cadastros →
  // Colaboradores. Ver comentário do grupo "Financeiro" em
  // frontend/lib/menu.ts.
  CONCILIACAO_CAIXA

  // Integração com a API de vendas da Meep (itens vendidos, CFOP/impostos
  // e conciliação de caixa por pagamento). Não entra no @default abaixo
  // de propósito — só a loja Contagem tem isso hoje; Anchieta e Raiz
  // ficam prontas no cadastro, mas só passam a ver a tela quando o Admin
  // Master ligar o módulo delas em /admin/modules.
  MEEP
}

model UserStore {
  id      String @id @default(uuid())
  userId  String
  storeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

model Supplier {
  id             String   @id @default(uuid())
  name           String
  // Deixou de ser @unique global: dois clientes-empresa diferentes podem
  // cadastrar um fornecedor com o mesmo nome (ex: "Ambev" em duas
  // empresas) sem colidir — a unicidade agora é por empresa, ver
  // @@unique abaixo.
  nameNormalized String
  cnpj           String?
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Multi-tenant: fornecedor era global (visível/editável por qualquer
  // empresa-cliente) — falha de isolamento real, corrigida aqui.
  // Obrigatório — rodou o backfill antes dessa migração tornar o campo
  // NOT NULL (mesmo esquema em 2 passos do Store.empresaId).
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  purchases        Purchase[]
  bills            Bill[]
  billRecorrencias BillRecorrencia[]

  categories         SupplierCategoryLink[]
  quotationSuppliers QuotationSupplier[]
  quotationsWon      Quotation[]            @relation("QuotationSelectedSupplier")

  // Lojas que esse fornecedor atende — opcional. Lista vazia (nenhuma
  // linha aqui) significa "atende todas as lojas" (comportamento padrão
  // de sempre, já que Supplier nunca foi por loja). Só passa a valer a
  // pena restringir quando o fornecedor é específico de um bar (ex: um
  // fornecedor de bebida que só entrega na Contagem) — usado pela
  // Cotação pra não convidar fornecedor errado pra loja errada.
  stores SupplierStore[]

  @@unique([nameNormalized, empresaId])
}

model SupplierStore {
  id String @id @default(uuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([supplierId, storeId])
  @@index([storeId])
}

// Categoria de fornecedor pra Cotação (ex: "Cervejas", "Carnes Bovinas",
// "Estoque seco") — cadastrável (Cadastros → Fornecedores), não é enum
// fixo. Um fornecedor pode ter várias categorias (ex: um distribuidor que
// vende cerveja E refrigerante). É o que decide pra quem cada lista de
// cotação é mandada.
model SupplierCategory {
  id             String @id @default(uuid())
  name           String
  // Idem Supplier.nameNormalized: deixou de ser @unique global — unicidade
  // agora é por empresa (@@unique abaixo).
  nameNormalized String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant: mesma correção do Supplier — categoria de fornecedor
  // era global. Obrigatório — rodou o backfill antes dessa migração.
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  suppliers       SupplierCategoryLink[]
  scheduleEntries QuotationScheduleEntry[]
  quotations      Quotation[]
  listItems       QuotationCategoryItem[]

  @@unique([nameNormalized, empresaId])
}

// Lista curada de itens de uma categoria de cotação — o que decide o
// que entra na "lista sugerida" da tela de Cotação. Existe por loja
// (mesmo item de Estoque de lojas diferentes é um StockItem diferente).
// Substitui a tentativa inicial de casar por nome (StockItem.categoria
// == SupplierCategory.name): o usuário monta a lista manualmente,
// escolhendo os itens do Estoque (ou digitando um item avulso que nem
// está no Estoque).
model QuotationCategoryItem {
  id String @id @default(uuid())

  categoryId String
  category   SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Vínculo com o Estoque — opcional. Quando preenchido, a lista usa a
  // quantidade atual/mínima/máxima ao vivo do StockItem (a não ser que
  // quantidadeSugeridaOverride esteja setado). Quando null, é um item
  // avulso (não cadastrado no Estoque) e descricaoManual/
  // unidadeMedidaManual/quantidadeSugeridaOverride passam a ser
  // obrigatórios.
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  descricaoManual     String?
  unidadeMedidaManual IngredientUnidade?

  // Ajuste manual da quantidade sugerida — sobrepõe o cálculo
  // automático (máximo - atual) do StockItem vinculado, ou é a única
  // fonte de quantidade quando o item é avulso.
  quantidadeSugeridaOverride Decimal? @db.Decimal(12, 3)

  ordem Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, stockItemId])
  @@index([categoryId])
  @@index([storeId])
}

model SupplierCategoryLink {
  id String @id @default(uuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  categoryId String
  category   SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([supplierId, categoryId])
  @@index([categoryId])
}

// Agenda fixa de cotação: em qual dia da semana cada categoria costuma
// ser cotada (ex: Segunda = Estoque seco + Cervejas + Carnes Bovinas).
// diaSemana segue o padrão do JS Date.getDay() — 0 = domingo ... 6 =
// sábado. É só uma sugestão padrão: a tela de Cotação usa isso pra já
// abrir com as categorias certas no dia certo, mas o usuário pode gerar
// a cotação de qualquer categoria em qualquer dia se quiser.
model QuotationScheduleEntry {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  diaSemana Int

  categoryId String
  category   SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([storeId, diaSemana, categoryId])
  @@index([storeId])
}

enum QuotationStatus {
  DRAFT // montada mas ainda não enviada pros fornecedores
  SENT // link mandado, esperando os fornecedores responderem
  SUPPLIER_SELECTED // usuário já escolheu o fornecedor vencedor, esperando ele confirmar
  ORDER_CONFIRMED // fornecedor confirmou (clicou OK) — Purchase já foi gerada
  CANCELED
}

// Uma rodada de cotação: uma categoria, uma lista de itens sugeridos, N
// fornecedores convidados a mandar preço. Quando o usuário escolhe um
// vencedor e ele confirma, vira uma Purchase automaticamente (ver
// purchaseId).
model Quotation {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   SupplierCategory @relation(fields: [categoryId], references: [id])

  status QuotationStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("QuotationCreatedBy", fields: [createdById], references: [id])

  sentAt DateTime?

  selectedSupplierId String?
  selectedSupplier   Supplier? @relation("QuotationSelectedSupplier", fields: [selectedSupplierId], references: [id])
  selectedAt         DateTime?

  orderConfirmedAt DateTime?

  // Preenchido quando o fornecedor confirma o pedido — é aí que a
  // Purchase (Fluxo 2: sem NF ainda, item a item na nota textual) é
  // criada automaticamente, pronta pra aparecer no recebimento.
  purchaseId String?   @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     QuotationItem[]
  suppliers QuotationSupplier[]

  @@index([storeId])
  @@index([categoryId])
}

// Um item da lista de cotação, com a quantidade em estoque/mínima/máxima
// "fotografadas" no momento em que a cotação foi montada (se o Estoque
// mudar depois, a cotação não muda retroativamente). stockItemId é
// opcional — dá pra cotar algo que ainda não está cadastrado no Estoque,
// só descrevendo o item na hora.
model QuotationItem {
  id String @id @default(uuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])

  descricao     String
  unidadeMedida IngredientUnidade @default(KG)

  quantidadeAtual    Decimal? @db.Decimal(12, 3)
  quantidadeMinima   Decimal? @db.Decimal(12, 3)
  quantidadeMaxima   Decimal? @db.Decimal(12, 3)
  quantidadeSugerida Decimal  @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  prices QuotationSupplierPrice[]

  @@index([quotationId])
}

// Um fornecedor convidado pra uma cotação — o link público que ele
// recebe é autenticado só pelo token (sem login). confirmToken só é
// gerado quando esse fornecedor especificamente ganha pelo menos um item
// (pode ganhar vários fornecedores na mesma cotação — ver
// QuotationSupplierPrice.selected — cada um com seu próprio confirmToken
// e sua própria Purchase, só com os itens que ele ganhou).
model QuotationSupplier {
  id String @id @default(uuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  token String @unique

  sentAt      DateTime?
  respondedAt DateTime?
  declinedAt  DateTime?

  confirmToken  String?   @unique
  confirmSentAt DateTime?
  confirmedAt   DateTime?

  // Preenchido quando esse fornecedor confirma o pedido (Fase 6) — só com
  // os itens que ele ganhou (ver QuotationSupplierPrice.selected). Cada
  // fornecedor vencedor numa cotação multi-fornecedor gera a sua própria
  // Purchase — diferente de Quotation.purchaseId (legado, de quando só
  // existia um vencedor por cotação inteira).
  purchaseId String?   @unique
  purchase   Purchase? @relation("QuotationSupplierPurchase", fields: [purchaseId], references: [id])

  createdAt DateTime @default(now())

  prices           QuotationSupplierPrice[]
  whatsappMessages WhatsappOutboundMessage[]

  @@unique([quotationId, supplierId])
  @@index([quotationId])
  @@index([supplierId])
}

// Preço que um fornecedor deu pra um item específico da cotação.
// `selected` é quem decide, célula a célula, de qual fornecedor aquele
// item vai ser comprado — dá pra ter itens de uma mesma cotação
// escolhidos de fornecedores diferentes. A aplicação garante (fora do
// Prisma, não dá pra expressar isso como constraint) que no máximo um
// QuotationSupplierPrice por quotationItemId fica com selected=true.
model QuotationSupplierPrice {
  id String @id @default(uuid())

  quotationSupplierId String
  quotationSupplier   QuotationSupplier @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)

  quotationItemId String
  quotationItem   QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  // Preço que o fornecedor mandou originalmente (preenchido só pela
  // página pública, nunca sobrescrito depois — serve de histórico/
  // comparação com editedUnitPrice).
  unitPrice Decimal @db.Decimal(12, 4)

  // Preço com desconto negociado manualmente pelo comprador (ex: ligação
  // pro fornecedor). Quando preenchido, é o valor usado no total do
  // fornecedor e na Purchase gerada — unitPrice original fica só de
  // referência ("antes: R$ X").
  editedUnitPrice Decimal?  @db.Decimal(12, 4)
  editedAt        DateTime?
  editedById      String?

  // Item escolhido desse fornecedor especificamente (clique na célula da
  // tela de comparação).
  selected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationSupplierId, quotationItemId])
  @@index([quotationItemId])
}

model Card {
  id         String  @id @default(uuid())
  name       String
  lastDigits String?
  holderName String?
  active     Boolean @default(true)

  storeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases Purchase[]
}

model Purchase {
  id          String         @id @default(uuid())
  description String
  value       Decimal        @db.Decimal(10, 2)
  status      PurchaseStatus @default(WAITING_RECEIPT)

  // Estágio fiscal (nota/cupom), separado do operacional acima — ver
  // comentário no enum PurchaseFiscalStatus. Linhas criadas antes dessa
  // migração começam todas em PENDING até o script de backfill rodar.
  fiscalStatus PurchaseFiscalStatus @default(PENDING)

  category PurchaseCategory @default(SUPPLIER_ORDER)
  origin   PurchaseOrigin   @default(NORMAL)
  method   PaymentMethod

  // "A pagar" (padrão) ou "Pago" — ver comentário no enum. Quem mexe em
  // Conciliar NF/Conta a Pagar (canManagePurchaseBilling) marca como Pago
  // quando a compra já foi quitada sem passar pelo módulo financeiro,
  // silenciando o alerta de "falta gerar conta a pagar" na lista.
  paymentStatus PurchasePaymentStatus @default(TO_PAY)

  requiresApproval Boolean @default(false)

  externalOrderCode String?

  purchasedAt DateTime?
  dueDate     DateTime?
  notes       String?

  // Foto/PDF do pedido feito ao fornecedor (print de WhatsApp, orçamento,
  // confirmação do site etc.) — anexado no cadastro, antes do recebimento.
  // Serve de referência pra conferir o que chegou, principalmente nas
  // compras cadastradas no modo simplificado (sem item a item).
  orderMirrorUrl  String?
  orderMirrorName String?

  // Fluxo 2 (compra sem NF e nem vai ter): descrição textual dos produtos
  // comprados, preenchida obrigatoriamente na hora de gerar a Conta a Pagar
  // quando não existe FiscalDocument tipo INVOICE nem COUPON pra essa
  // compra. Serve de referência futura pra vincular ao estoque manualmente
  // (a foto do cupom, quando enviada, vai como FiscalDocument tipo COUPON —
  // não precisa de campo próprio aqui).
  noInvoiceProductsNote String?

  // Fluxo 2: quando os itens dessa compra (sem NF) foram vinculados
  // manualmente ao Estoque (aba "Compras sem NF" em Vincular NF). null =
  // ainda pendente. Equivalente ao IncomingGoodsNf.stockLinkedAt do Fluxo 1.
  stockLinkedAt DateTime?

  storeId     String
  supplierId  String?
  cardId      String?
  createdById String
  updatedById String?

  approvedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  checkedById String?
  checkedAt   DateTime?

  invoiceResponsibleId String?

  closedById String?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  card     Card?     @relation(fields: [cardId], references: [id])

  createdBy          User  @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  updatedBy          User? @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id])
  approvedBy         User? @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  checkedBy          User? @relation("PurchaseCheckedBy", fields: [checkedById], references: [id])
  invoiceResponsible User? @relation("PurchaseInvoiceResponsible", fields: [invoiceResponsibleId], references: [id])
  closedBy           User? @relation("PurchaseClosedBy", fields: [closedById], references: [id])

  items            PurchaseItem[]
  receipts         PurchaseReceipt[]
  approvals        Approval[]
  fiscalDocuments  FiscalDocument[]
  attachments      Attachment[]
  histories        PurchaseHistory[]
  purchaseAlerts   PurchaseAlert[]
  bills            Bill[]
  incomingGoodsNfs IncomingGoodsNf[]

  // Preenchido quando essa compra nasceu automaticamente de uma Cotação
  // confirmada pelo fornecedor (ver Quotation.purchaseId, campo legado de
  // quando só existia um vencedor por cotação inteira) — nesse caso
  // origin vem WHATSAPP (enum PurchaseOrigin já tinha esse valor).
  quotation Quotation?

  // Compra gerada pela confirmação de UM fornecedor específico numa
  // cotação multi-fornecedor (ver QuotationSupplier.purchaseId) — só com
  // os itens que esse fornecedor ganhou.
  quotationSupplier QuotationSupplier? @relation("QuotationSupplierPurchase")

  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@index([fiscalStatus])
  @@index([category])
  @@index([origin])
  @@index([method])
  @@index([purchasedAt])
  @@index([dueDate])
  @@index([approvedById])
  @@index([invoiceResponsibleId])
  // Índices compostos pra acelerar a lista de Compras — ela sempre filtra
  // por loja(s) + status e ordena por criação; sem esses dois, Postgres
  // tem que usar só um índice simples e filtrar/ordenar o resto na mão
  // conforme a tabela cresce.
  @@index([storeId, status])
  @@index([createdAt])
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String

  name      String
  quantity  Decimal  @db.Decimal(10, 3)
  unit      String?
  unitPrice Decimal? @db.Decimal(10, 2)
  total     Decimal? @db.Decimal(10, 2)

  receivedQuantity Decimal? @db.Decimal(10, 3)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model PurchaseReceipt {
  id String @id @default(uuid())

  purchaseId   String
  receivedById String

  status     ReceiptStatus
  notes      String?
  finalValue Decimal?      @db.Decimal(10, 2)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  receivedBy User     @relation(fields: [receivedById], references: [id])

  fiscalDocuments FiscalDocument[]

  @@index([purchaseId])
  @@index([receivedById])
  @@index([status])
}

model FiscalDocument {
  id     String               @id @default(uuid())
  type   FiscalDocumentType
  status FiscalDocumentStatus @default(LINKED)

  number    String?
  accessKey String?
  fileUrl   String?
  issueDate DateTime?
  value     Decimal?  @db.Decimal(10, 2)

  purchaseId   String
  uploadedById String?
  receiptId    String?

  linkedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchase   Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  uploadedBy User?            @relation(fields: [uploadedById], references: [id])
  receipt    PurchaseReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  linkedTo FiscalDocument?  @relation("DocumentLink", fields: [linkedToId], references: [id])
  linkedBy FiscalDocument[] @relation("DocumentLink")

  @@index([purchaseId])
  @@index([receiptId])
  @@index([type])
  @@index([status])
  @@index([accessKey])
}

model Bill {
  id          String  @id @default(uuid())
  description String
  value       Decimal @db.Decimal(10, 2)

  type          PayableType       @default(BOLETO)
  paymentMethod BillPaymentMethod @default(BANK_SLIP)

  dueDate DateTime
  paidAt  DateTime?

  status BillStatus @default(OPEN)

  // Preenchido quando alguém marca manualmente uma conta vencida como
  // "incluir nos pagamentos de hoje" — não muda o vencimento nem o status
  // (continua aparecendo como Vencida), só faz ela entrar também na lista
  // "Hoje" e no relatório do dia. Fica null de novo quando a conta é paga.
  queuedForPaymentAt DateTime?

  hasBillFile Boolean @default(false)

  barcode String?

  pixKey     String?
  pixKeyType PixKeyType?
  pixQrCode  String?

  bankName    String?
  bankAgency  String?
  bankAccount String?
  beneficiary String?

  storeId       String
  purchaseId    String?
  supplierId    String?
  categoryId    String?
  launchedById  String
  // Preenchido quando esse Bill foi gerado automaticamente a partir de uma
  // BillRecorrencia (ver modelo abaixo) — editar/excluir esse Bill depois
  // não afeta a recorrência nem as outras ocorrências já geradas.
  recorrenciaId String?

  fileUrl         String?
  imageUrl        String?
  paymentProofUrl String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store            @relation(fields: [storeId], references: [id])
  purchase    Purchase?        @relation(fields: [purchaseId], references: [id])
  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
  category    BillCategory?    @relation(fields: [categoryId], references: [id])
  launchedBy  User             @relation("BillLaunchedBy", fields: [launchedById], references: [id])
  recorrencia BillRecorrencia? @relation(fields: [recorrenciaId], references: [id])

  // NF que deram origem a essa conta ao serem aceitas direto (sem passar
  // por Compra/Serviço já cadastrado) — ver IncomingGoodsNf/IncomingServiceNf.
  incomingGoodsNfs   IncomingGoodsNf[]   @relation("IncomingGoodsNfBill")
  incomingServiceNfs IncomingServiceNf[] @relation("IncomingServiceNfBill")

  // Garante que gerar ocorrências duas vezes (cron rodando de novo, ou
  // criação + cron no mesmo dia) nunca duplica o Bill da mesma data —
  // mesmo raciocínio do @@unique equivalente no Controle Rota.
  @@unique([recorrenciaId, dueDate])
  @@index([storeId])
  @@index([purchaseId])
  @@index([supplierId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([paymentMethod])
  @@index([dueDate])
  @@index([barcode])
  @@index([queuedForPaymentAt])
  @@index([pixKey])
  // Composto pra acelerar a lista de Contas a Pagar (loja + status,
  // mesmo raciocínio do índice equivalente em Purchase) + createdAt pra
  // quando alguém ordenar/paginar por data de criação em vez de vencimento.
  @@index([storeId, status])
  @@index([createdAt])
}

// Definição de uma conta recorrente (ex: aluguel, internet, condomínio da
// Loja Física do proprietário). Não guarda o Bill em si — a cada ciclo o
// job de geração cria um Bill novo apontando pra essa recorrência (campo
// Bill.recorrenciaId), sempre MESES_GERACAO meses à frente, do mesmo jeito
// que o Controle Rota já faz pra ContaPagarRecorrencia.
model BillRecorrencia {
  id          String             @id @default(uuid())
  description String
  value       Decimal            @db.Decimal(10, 2)
  recurrence  BillRecurrenceType

  // Só usado quando recurrence = WEEKLY. 0=domingo ... 6=sábado.
  weekday Int?

  // Só usado quando recurrence = MONTHLY. 1-30 (se o mês não tiver esse
  // dia, cai no último dia do mês).
  dayOfMonth Int?

  type          PayableType       @default(BOLETO)
  paymentMethod BillPaymentMethod @default(BANK_SLIP)

  storeId     String
  categoryId  String?
  supplierId  String?
  createdById String
  active      Boolean @default(true)

  // Até quando já foram geradas ocorrências (Bill) — o cron/criação
  // sempre estende até MESES_GERACAO meses a partir de hoje.
  generatedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store         @relation(fields: [storeId], references: [id])
  category  BillCategory? @relation(fields: [categoryId], references: [id])
  supplier  Supplier?     @relation(fields: [supplierId], references: [id])
  createdBy User          @relation("BillRecorrenciaCreatedBy", fields: [createdById], references: [id])
  bills     Bill[]

  @@index([storeId])
  @@index([active])
}

enum BillRecurrenceType {
  WEEKLY
  MONTHLY
}

// Conciliação de caixa: por loja e por dia, compara o que entrou "de
// acordo com o sistema" (lançado manualmente por forma de pagamento —
// não existe integração com PDV/frente de caixa) com o que efetivamente
// caiu no banco naquele dia, também quebrado por forma de pagamento (pra
// apontar exatamente onde está a diferença, não só o total). Pensado pra
// impressão/PDF de apoio à tomada de decisão, não é lançamento contábil.
model CashReconciliation {
  id String @id @default(uuid())

  storeId String
  // Data do movimento (dia do caixa), sem componente de hora relevante —
  // mesma convenção de outros campos de data-only do projeto (horário
  // intermediário gravado pelo backend pra nunca recuar de dia por fuso).
  date    DateTime

  systemCash   Decimal @default(0) @db.Decimal(10, 2)
  systemDebit  Decimal @default(0) @db.Decimal(10, 2)
  systemCredit Decimal @default(0) @db.Decimal(10, 2)

  bankCash   Decimal @default(0) @db.Decimal(10, 2)
  bankDebit  Decimal @default(0) @db.Decimal(10, 2)
  bankCredit Decimal @default(0) @db.Decimal(10, 2)

  // "Outros" e "Vale/retirada" saíram daqui — agora vivem na aba
  // Conciliação de Caixa de Vendas Meep (MeepCashExtra, por loja+dia,
  // junto com Freelancer/Descontos), que é onde o usuário realmente
  // preenche isso no dia a dia.
  notes String?

  launchedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store @relation(fields: [storeId], references: [id])
  launchedBy User  @relation("CashReconciliationLaunchedBy", fields: [launchedById], references: [id])

  // Uma conciliação por loja/dia — lançar de novo no mesmo dia atualiza
  // (upsert), nunca duplica.
  @@unique([storeId, date])
  @@index([storeId])
  @@index([date])
}

// Dados do Convênio de Pagamentos no Sicredi — usados só pra montar o
// cabeçalho do arquivo CNAB 240 de "lançamento em lote" (pagar boletos e
// PIX de uma vez, subindo o arquivo no Sicredi). Único registro pra toda
// a empresa (não é por loja) — o serviço sempre lê/atualiza a linha mais
// recente. Não são credenciais de acesso (não dá pra logar com isso),
// só identificação bancária exigida pelo layout do banco.
model PaymentBatchConfig {
  id String @id @default(uuid())

  bankCode String @default("748") // Sicredi

  convenioCode String // código do Convênio de Pagamentos no Sicredi
  agencia      String
  agenciaDv    String?
  conta        String
  contaDv      String?

  companyName String
  companyCnpj String

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  // Multi-tenant: era "o único registro da empresa toda" — literalmente
  // 1 linha global no banco, com dado bancário sensível (agência/conta)
  // compartilhado entre TODAS as empresas-cliente. Agora é 1 registro
  // obrigatório POR empresa (@@unique garante só um por empresa).
  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}

// Categoria livre da conta a pagar (ex.: Revenda, Matéria-prima,
// Manutenção...) — cadastrada na hora (igual Fornecedor: digita e cria se
// não existir). A ideia é que, com o tempo, cada Fornecedor tenha um
// padrão de categoria e o sistema sugira sozinho nas próximas NFs.
model BillCategory {
  id             String   @id @default(uuid())
  name           String
  // Idem Supplier/SupplierCategory: deixou de ser @unique global.
  nameNormalized String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Multi-tenant: categoria de conta a pagar também era global.
  // Obrigatório — rodou o backfill antes dessa migração.
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  bills            Bill[]
  billRecorrencias BillRecorrencia[]

  @@unique([nameNormalized, empresaId])
}

model Service {
  id           String  @id @default(uuid())
  name         String
  providerName String
  description  String?
  value        Decimal @db.Decimal(10, 2)

  serviceDate DateTime
  notes       String?

  nfFileUrl      String?
  nfOriginalName String?

  paymentMethod PayoutMethod @default(PIX)
  pixKey        String?
  pixKeyType    PixKeyType?

  storeId     String
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation("ServiceCreatedBy", fields: [createdById], references: [id])

  incomingNfs IncomingServiceNf[]

  @@index([storeId])
  @@index([serviceDate])
  @@index([name])
}

// Certificado digital (e-CNPJ) usado pra autenticar via mTLS nas APIs da
// Sefaz/NFS-e Nacional. O arquivo .pfx fica fora da pasta /uploads (que é
// servida publicamente) e a senha nunca é gravada em texto puro — só o
// resultado da criptografia AES-256-GCM feita com CERT_ENCRYPTION_KEY.
model StoreCertificate {
  id      String @id @default(uuid())
  storeId String @unique

  fileName String
  filePath String

  passwordCipher  String
  passwordIv      String
  passwordAuthTag String

  // Cursor da distribuição de documentos da Sefaz (NSU = Número Sequencial
  // Único). Cada busca continua a partir daqui, em vez de reprocessar tudo
  // de novo.
  lastNsu BigInt @default(0)

  // Cursor separado pra distribuição de NF-e de mercadoria (webservice
  // NFeDistribuicaoDFe da Receita, produção nacional) — é um sistema
  // totalmente diferente do ADN de NFS-e acima, com numeração de NSU
  // própria; não pode compartilhar o mesmo cursor.
  lastNsuNfe BigInt @default(0)

  // Até quando NÃO vale a pena tentar sincronizar de novo (Sefaz/ADN pedem
  // pelo menos 1h de espera depois de "nada de novo" ou de um bloqueio por
  // "consumo indevido" — e reinicia a contagem se a gente insistir antes da
  // hora passar). Null = sem bloqueio conhecido no momento. Campos
  // separados porque NF-e (Sefaz) e NFS-e (ADN) são sistemas independentes.
  nfeBlockedUntil  DateTime?
  nfseBlockedUntil DateTime?

  uploadedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("StoreCertificateUploadedBy", fields: [uploadedById], references: [id])
}

// Registro de cada tentativa de buscar documentos fiscais na Sefaz/ADN —
// manual (clique em "Buscar") ou automática (job agendado). Existe pra dar
// visibilidade a erros que aconteceriam sem ninguém olhando, como uma busca
// automática de madrugada que esbarrou em bloqueio da Sefaz.
model SefazSyncLog {
  id      String @id @default(uuid())
  storeId String

  // 'NFE_COMPRA' (mercadoria, via SEFAZ) ou 'NFSE_SERVICO' (via ADN).
  source String

  success      Boolean
  message      String
  fetchedTotal Int     @default(0)

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, source, createdAt])
}

// Documento fiscal baixado da distribuição da Sefaz (NF-e de serviço, DPS ou
// evento) que ainda não foi conciliado com um Serviço cadastrado. O XML fica
// salvo em /uploads (mesmo padrão do envio manual); serviceId só é
// preenchido quando o usuário confirma a qual Serviço aquele documento
// pertence.
model IncomingServiceNf {
  id String @id @default(uuid())

  storeId String

  nsu           BigInt
  chaveAcesso   String
  tipoDocumento String
  tipoEvento    String?

  // Extraídos do XML completo (ArquivoXml do ADN) na hora da captura — pra
  // mostrar informação útil no card de conciliação em vez de só a chave de
  // acesso. Podem ficar em branco se o documento não trouxer XML (só
  // resumo/evento) ou se o schema do NFS-e nacional divergir do esperado.
  numeroNf   String?
  issuerName String? // nome do prestador do serviço
  issuerDoc  String? // CNPJ/CPF do prestador
  value      Decimal?  @db.Decimal(10, 2)
  issueDate  DateTime?

  fileUrl     String?
  generatedAt DateTime?
  fetchedAt   DateTime  @default(now())

  serviceId String?
  ignored   Boolean @default(false) // marcado como "não é nossa"/recusado

  // Aceita direto (sem vincular a um Serviço já cadastrado): accepted =
  // aceita sem gerar conta, billId = aceita e a conta a pagar foi criada
  // direto a partir dessa NF.
  accepted Boolean @default(false)
  billId   String?

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
  bill    Bill?    @relation("IncomingServiceNfBill", fields: [billId], references: [id])

  @@unique([storeId, chaveAcesso])
  @@index([storeId])
  @@index([serviceId])
  @@index([tipoDocumento])
  @@index([billId])
}

// Documento fiscal baixado da distribuição da Sefaz (NF-e de mercadoria
// emitida pra o CNPJ da loja) que ainda não foi conciliado com uma Compra
// cadastrada. Diferente da NFS-e, a resposta padrão do distDFeInt é só o
// "resumo" (resNFe) — por isso já guardamos emitente/valor/data extraídos
// dali, sem depender do XML completo (que só vem depois de manifestação,
// funcionalidade que fica pra uma fase seguinte). purchaseId só é
// preenchido quando o usuário confirma a qual compra aquela NF pertence.
model IncomingGoodsNf {
  id String @id @default(uuid())

  storeId String

  nsu           BigInt
  chaveAcesso   String
  tipoDocumento String // resNFe | resEvento | resCancNFe | procNFe etc.

  issuerCnpj String?
  issuerName String?
  value      Decimal?  @db.Decimal(10, 2)
  issueDate  DateTime?
  situacao   String? // cSitNFe do resumo: autorizada, cancelada, etc.

  fileUrl   String?
  fetchedAt DateTime @default(now())

  // Manifestação do destinatário (Ciência da Operação) — enviada
  // automaticamente pro documento que chegou como resumo (resNFe), pra
  // Sefaz liberar o XML completo (com itens) na próxima consulta.
  // manifestStatus guarda o texto de retorno (sucesso ou erro) só pra
  // diagnóstico; não bloqueia nada se der errado.
  manifestedAt   DateTime?
  manifestStatus String?

  // De onde veio esse registro: busca automática na Sefaz (padrão) ou
  // upload manual de XML feito pelo usuário (fallback pra quando a API não
  // funciona). Não muda o fluxo de conciliação, só identifica a origem na
  // tela.
  source IncomingNfSource @default(SEFAZ)

  purchaseId String?
  ignored    Boolean @default(false) // marcado como "não é nossa"/recusado

  // Aceita direto (sem vincular a uma Compra já cadastrada): accepted =
  // aceita sem gerar conta, billId = aceita e a conta a pagar foi criada
  // direto a partir dessa NF.
  accepted Boolean @default(false)
  billId   String?

  // Preenchido quando o usuário termina de ligar os itens dessa NF a
  // itens do Estoque (ver StockMovement, origem NF_COMPRA) — só pra UI
  // mostrar "já vinculado" sem precisar contar StockMovement toda hora.
  stockLinkedAt DateTime?

  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchase   Purchase?      @relation(fields: [purchaseId], references: [id])
  bill       Bill?          @relation("IncomingGoodsNfBill", fields: [billId], references: [id])
  devolucoes DevolucaoNfe[]

  @@unique([storeId, chaveAcesso])
  @@index([storeId])
  @@index([purchaseId])
  @@index([tipoDocumento])
  @@index([billId])
}

enum IncomingNfSource {
  SEFAZ
  XML_UPLOAD
}

// NF-e/NFC-e de venda (a loja é a emitente), importadas em lote via upload
// manual de XML — hoje não existe distribuição automática confiável pra
// nota de saída, então o fluxo é sempre o usuário exportar do sistema de
// venda/PDV e subir aqui. referenceMonth já vem calculado do issueDate pra
// agrupar rápido e alimentar o RevenueEntry (Faturamento) do mês.
model OutgoingSalesNf {
  id String @id @default(uuid())

  storeId String

  chaveAcesso   String
  tipoDocumento String // 55 = NF-e, 65 = NFC-e (campo mod do XML)

  recipientCnpj  String?
  recipientName  String?
  value          Decimal  @db.Decimal(10, 2)
  issueDate      DateTime
  referenceMonth String // "AAAA-MM", derivado do issueDate
  situacao       String?

  fileUrl      String?
  importedAt   DateTime @default(now())
  importedById String

  ignored Boolean @default(false) // marcado como importado por engano

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  importedBy User  @relation("OutgoingSalesNfImportedBy", fields: [importedById], references: [id])

  @@unique([storeId, chaveAcesso])
  @@index([storeId])
  @@index([referenceMonth])
}

// Um "lote" de importação da planilha de vendas do PDV/sistema de comanda
// (relatório por produto — ex: export "Nu Galho Raiz"), usada pra análise
// de quantidade vendida, margem e comparação com o que foi comprado (NF de
// entrada). Cada linha vira um ProductSalesEntry; o cabeçalho aqui guarda
// os metadados do próprio arquivo exportado (nome do local, quem exportou,
// quando) só pra referência/auditoria — não tem efeito nenhum no cálculo.
model ProductSalesImport {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // MANUAL = planilha subida por alguém (fluxo original). MEEP = gerado
  // automaticamente a partir das vendas sincronizadas da API Meep (ver
  // MeepProductSalesSyncService) — nesse caso meepBusinessDay guarda o
  // dia comercial (YYYY-MM-DD, 08h-04h Brasília) que esse import
  // representa, e o registro é reaproveitado (upsert) a cada
  // sincronização daquele dia em vez de criar um novo a cada hora.
  origem          ProductSalesImportOrigem @default(MANUAL)
  meepBusinessDay String?

  nomeLocal    String?
  exportadoPor String?
  exportadoEm  DateTime?

  // Período coberto pelo relatório (ex: "do dia 1 ao dia 15") — a
  // planilha não traz isso, então é informado manualmente por quem
  // importa, na hora do upload. Mostrado no histórico de importações e
  // usado pra dar contexto de data à análise (não filtra nada sozinho,
  // já que quem decide o recorte de dados é o relatório exportado do
  // PDV, não este sistema).
  periodoInicio DateTime?
  periodoFim    DateTime?

  arquivoOriginal String
  totalLinhas     Int

  importedById String?
  importedBy   User?    @relation("ProductSalesImportImportedBy", fields: [importedById], references: [id])
  createdAt    DateTime @default(now())

  entries ProductSalesEntry[]

  @@unique([storeId, meepBusinessDay])
  @@index([storeId])
}

enum ProductSalesImportOrigem {
  MANUAL
  MEEP
}

// Uma linha (um produto) de uma importação — categoria/produto exatamente
// como veio na planilha, mais "produtoChave" (normalizado: maiúsculo, sem
// espaço duplicado) pra facilitar agrupar o mesmo produto entre
// importações diferentes e, mais pra frente, casar com o nome do item na
// NF de entrada pra calcular margem.
model ProductSalesEntry {
  id String @id @default(uuid())

  importId String
  import   ProductSalesImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  categoria    String
  produto      String
  produtoChave String

  quantidade Decimal @db.Decimal(12, 3)
  valor      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([importId])
  @@index([produtoChave])
}

// Como o consumo de um ingrediente deve ser lido/contado. KG é peso
// (a "gramas" da ficha técnica é peso mesmo — Contra Filé, Batata) —
// comportamento padrão, igual sempre foi. UNIDADE é contagem (a
// "gramas" da ficha técnica na real guarda quantas UNIDADES daquele
// ingrediente o prato leva, ex: Coxinha 5 = 5 coxinhas por prato, não
// 5 gramas) — pra item que não se pesa, se conta (Pastel, Coxinha,
// Camafeu, Costelinha Suína...).
enum IngredientUnidade {
  KG
  LITRO
  UNIDADE
}

// Uma linha da "ficha técnica" de um prato vendido: quanto de UM item de
// estoque aquele prato leva (ex: "Chapa de Contra Filé" leva 400g de
// Batata + 400g de Contra Filé = duas linhas). produtoChave referencia o
// mesmo produto normalizado usado em ProductSalesEntry — não há FK direta
// porque a receita é cadastrada independente de ter vindo alguma venda
// daquele produto ainda.
//
// O campo "gramas" é lido de dois jeitos, dependendo do
// StockItem.unidadeMedida do item da linha (não muda o nome da coluna pra
// não precisar migrar dado já digitado):
//   - item KG/LITRO (padrão): "gramas" é peso/volume mesmo. Consumo no
//     período = soma, pra cada prato vendido que usa esse item,
//     quantidadeVendida * gramas / 1000 (kg/l).
//   - item UNIDADE (Pastel, Coxinha, Costelinha...): "gramas" na real
//     guarda quantas UNIDADES o prato leva (ex: 5 = 5 coxinhas). Consumo
//     no período = quantidadeVendida * gramas, direto, sem dividir por
//     1000 (é contagem, não peso).
model ProductRecipeItem {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  produtoChave String
  produto      String

  // Cada linha da ficha técnica aponta pra EXATAMENTE UM dos dois: um
  // StockItem (consumo direto do Estoque bruto, fluxo original) OU um
  // ProductionItem (pré-preparo da aba Produção — Picanha 200g porcionada,
  // Molho da Casa etc.). Nunca os dois nem nenhum — validado na
  // aplicação (saveRecipe/importarFichasTecnicasExcel), não dá pra
  // expressar isso como CHECK constraint direto no Prisma. Quando existe
  // um ProductionItem com o mesmo nome do insumo, a UI deve preferir esse
  // vínculo em vez do StockItem direto (ver decisão em PROJECT_STATUS) —
  // assim a baixa por venda cai no estoque de produção, não no estoque
  // bruto.
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  productionItemId String?
  productionItem   ProductionItem? @relation(fields: [productionItemId], references: [id], onDelete: Cascade)

  gramas Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, produtoChave, stockItemId])
  @@unique([storeId, produtoChave, productionItemId])
  @@index([storeId, produtoChave])
  @@index([stockItemId])
  @@index([productionItemId])
}

// Cópia de segurança das fichas técnicas de UMA loja, tirada bem antes de
// rodar uma importação em massa (planilha) que substitui receitas
// existentes. Guarda só a última — cada nova importação sobrescreve esta
// linha — o suficiente pra um "desfazer" de um nível (voltar pro estado
// de antes da última importação em massa). snapshot é a lista completa
// de ProductRecipeItem da loja no momento do backup, desnormalizada
// (nome do ingrediente em vez de ID) pra não depender de nada que possa
// ter sido apagado depois.
model ProductRecipeImportBackup {
  id String @id @default(uuid())

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  snapshot Json

  createdAt DateTime @default(now())
}

// Um item físico de estoque — matéria-prima ou produto de revenda —
// cadastrado pela loja. Também é o insumo usado diretamente na ficha
// técnica dos produtos vendidos (ver ProductRecipeItem.stockItemId) e/ou
// na receita de um pré-preparo (ver ProductionRecipeItem.stockItemId) —
// não existe mais um catálogo de "Ingrediente" separado: as informações
// de gramatura/categoria da Lista de Compra vivem aqui, direto no item de
// estoque.
model StockItem {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  nome      String
  nomeChave String
  // Categoria fixa de negócio — Hortifruti / Matéria Prima / Revenda /
  // Ativo (ver ESTOQUE_CATEGORIAS em estoque.service.ts). Continua String
  // (não enum) pra não quebrar dado antigo já cadastrado fora dessa lista,
  // mas o frontend só deixa escolher uma dessas 4 opções.
  categoria String?
  // Descrição livre — classificação mais fina que a Categoria (ex: "Folhas,
  // Ervas e Brotos", "Proteínas - Frigorífico", "Bebidas - Whisky e Gin").
  // Não entra em nenhuma regra de negócio, é só informativo/organizacional.
  descricao String?

  unidadeMedida IngredientUnidade @default(KG)

  quantidadeAtual    Decimal  @default(0) @db.Decimal(12, 3)
  // Custo médio ponderado — recalculado a cada ENTRADA que vier com
  // valorTotal preenchido. Opcional porque nem toda entrada informa
  // valor (ex: planilha modelo com quantidade mas sem valor).
  valorMedioUnitario Decimal? @db.Decimal(12, 4)

  // Peso (em gramas) de UMA peça/pacote inteiro desse item — ex: uma
  // picanha inteira ~1200g, um pacote de batata frita porcionado 400g.
  // Só faz sentido pra item KG; opcional (null = não sei converter esse
  // item em "quantas peças/pacotes comprar", só mostra o KG mesmo). Usado
  // pra além do KG total, sugerir também "quantas peças/pacotes" comprar
  // (arredondando pra cima).
  pesoUnidadeGramas Decimal? @db.Decimal(10, 2)

  // Marca se esse item é uma proteína/carne (Picanha, Ancho, Filé Mignon,
  // Costelinha Suína...). Usado pra filtrar a Lista de Compra: só entra
  // proteína OU item contado por UNIDADE (Pastel, Coxinha, Camafeu,
  // Costelinha...) — o resto (acompanhamento sem gramatura relevante,
  // tipo arroz, salada) fica de fora da sugestão de compra. Não afeta o
  // Estoque normal, só a Lista de Compra de Produtos.
  isProteina Boolean @default(false)

  // Porção "padrão" de corte desse item (em gramas) — ex: 200 pra
  // Ancho/Picanha/Baby Beef/Filé Mignon, que a loja sempre porciona em
  // pedaços de 200g. Usado só na visão "Tamanho" da Lista de Compra pra
  // normalizar gramaturas diferentes da ficha técnica na MESMA porção:
  // qualquer prato com gramas >= porção padrão vira N porções
  // (arredondando pro inteiro mais próximo — ex: 400g e 350g de Filé
  // Mignon viram "2x 200g"), tudo somado numa linha só. Gramas MENOR que
  // a porção padrão (ex: Filé Mignon 100g do Kids) não mescla — fica
  // como porção própria, diferente da porção adulta. Opcional (null =
  // não normaliza, cada gramatura vira sua própria linha, como antes).
  porcaoPadraoGramas Decimal? @db.Decimal(10, 2)

  // Agrupamento da Lista de Compra por seção do pedido pro fornecedor, do
  // jeito que o chefe de produção organiza (ex: "Proteínas e Cortes",
  // "Feijoada", "Noite de petiscos"). String livre (não enum Prisma) pra
  // não exigir migração toda vez que uma seção for renomeada/adicionada.
  // null = item sem categoria definida, cai no grupo "Outros" no fim da
  // lista. ordemLista é a posição dentro dessa categoria (menor primeiro);
  // null/empate cai por ordem alfabética.
  categoriaLista String?
  ordemLista     Int?

  // Estoque mínimo — abaixo disso o item entra na Lista de Compra do
  // Estoque (ver endpoint /estoque/lista-compra), com a quantidade
  // sugerida sendo a diferença até aqui. Opcional (null = item não
  // entra em nenhuma sugestão de compra, mesmo zerado).
  estoqueMinimo Decimal? @db.Decimal(12, 3)

  // Estoque máximo — usado só pela Cotação (ver Quotation/QuotationItem)
  // pra calcular a quantidade sugerida de compra (máximo - atual, sem
  // deixar negativo). Opcional: item sem máximo cadastrado não entra na
  // sugestão automática de cotação, mesmo que tenha mínimo.
  estoqueMaximo Decimal? @db.Decimal(12, 3)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements              StockMovement[]
  supplierMappings       StockSupplierItemMapping[]
  quotationItems         QuotationItem[]
  quotationCategoryItems QuotationCategoryItem[]
  productionRecipeLinks  ProductionRecipeItem[]
  productRecipeItems     ProductRecipeItem[]

  @@unique([storeId, nomeChave])
  @@index([storeId])
}

// "Aprendizado" de qual item de estoque corresponde à descrição de um
// item de NF de UM fornecedor específico — criado/atualizado
// automaticamente toda vez que um vínculo NF→Estoque é confirmado (ver
// EstoqueService.vincularNfAoEstoque). Da próxima vez que o MESMO
// fornecedor (por CNPJ) mandar uma NF com item de descrição igual, a
// tela de vínculo já vem com a sugestão pré-preenchida — só falta
// confirmar ou editar. Chave por (loja, CNPJ do emitente, descrição
// normalizada do item), não por produto/NCM, porque é assim que o item
// aparece identificado na NF.
model StockSupplierItemMapping {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  issuerCnpj     String
  descricaoChave String

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, issuerCnpj, descricaoChave])
  @@index([storeId])
  @@index([stockItemId])
}

enum StockMovementType {
  ENTRADA
  SAIDA
}

// De onde veio o lançamento — só pra mostrar contexto na tela de
// movimentações (ex: "gerado pela NF X" ou "baixa automática da
// importação Y"), não muda o efeito no saldo.
enum StockMovementOrigin {
  NF_COMPRA // vínculo manual com item de NF de mercadoria aceita
  MANUAL // lançamento avulso (entrada ou ajuste/baixa manual, item por item)
  IMPORTACAO_PLANILHA // planilha modelo (Nome/Categoria/Quantidade/Valor)
  CONSUMO_VENDA // baixa automática calculada a partir da importação de vendas (aba Produtos)
  COMPRA_SEM_NF // Fluxo 2: vínculo manual de itens de uma compra sem NF (descrição/foto do cupom), sem XML pra ler
}

// Ledger de entradas/saídas de UM StockItem. sourceRef é uma chave
// natural opcional (formato livre por origem, ex:
// "nf:<incomingGoodsNfId>:item:3" ou
// "venda:<productSalesImportId>:item:<stockItemId>") usada só pra deixar
// idempotente reprocessar a mesma origem (reabrir o vínculo de uma NF já
// vinculada, ou o listener de uma importação de vendas que rodou de
// novo) — sem ela, cada replay duplicaria o lançamento. Lançamento
// manual não tem sourceRef (null).
model StockMovement {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  tipo   StockMovementType
  origem StockMovementOrigin

  quantidade Decimal  @db.Decimal(12, 3)
  valorTotal Decimal? @db.Decimal(12, 2)

  sourceRef  String?
  observacao String?

  data DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([storeId, sourceRef])
  @@index([storeId])
  @@index([stockItemId])
}

// Unidade em que o estoque de PRODUÇÃO (pré-preparo) de um item é
// contado — diferente de IngredientUnidade (KG/UNIDADE) porque aqui
// também aparece ML (molhos, caldos, líquidos porcionados).
enum ProductionUnidade {
  KG
  ML
  UNIDADE
}

// Tipo de movimentação no ledger de um ProductionItem — mesmo espírito
// de StockMovement, só que aqui só existem essas 3 origens possíveis (o
// resto do fluxo de Estoque, como NF/compra, não se aplica: um item de
// Produção só nasce sendo produzido).
enum ProductionMovementType {
  PRODUCAO // registrado manualmente: "hoje porcionei/produzi X" (credita o saldo)
  CONSUMO_VENDA // baixa automática pela importação de vendas (aba Produtos), igual StockMovement
  AJUSTE // correção manual de saldo (ex: perda, quebra, contagem)
}

// Pré-preparo/porcionamento — a aba Produção. Um ProductionItem tem
// ESTOQUE PRÓPRIO (quantidadeAtual), separado do StockItem bruto: é o
// "Picanha 200g" (porção cortada da Picanha 10kg do Estoque) ou o "Molho
// da Casa" (feito a partir de alho + cebolinha + óleo do Estoque). A
// ficha técnica de um prato pode apontar pra um ProductionItem em vez de
// um Ingredient/StockItem direto — nesse caso a baixa por venda desconta
// só daqui, nunca cascateia até o Estoque bruto (isso já aconteceu na
// hora de PRODUZIR, não na hora de VENDER).
//
// baseQuantidade é o "tamanho de lote" da receita abaixo, na própria
// unidadeMedida deste item: ex. Molho da Casa (unidadeMedida=ML,
// baseQuantidade=100) tem sua receita expressa "por 100ml"; Picanha 200g
// (unidadeMedida=UNIDADE, baseQuantidade=1) tem sua receita expressa
// "por 1 porção". Ao registrar uma produção de X (na unidade do item), o
// fator aplicado sobre cada componente da receita é X / baseQuantidade.
model ProductionItem {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  nome      String
  nomeChave String

  unidadeMedida   ProductionUnidade @default(KG)
  baseQuantidade  Decimal           @default(1) @db.Decimal(12, 3)
  quantidadeAtual Decimal           @default(0) @db.Decimal(12, 3)

  active Boolean @default(true)

  recipeItems        ProductionRecipeItem[]
  movements          ProductionMovement[]
  productRecipeLinks ProductRecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, nomeChave])
  @@index([storeId])
}

// Um componente da receita de um ProductionItem — quanto de UM StockItem
// (na unidade do próprio StockItem) é gasto a cada "baseQuantidade"
// produzida. Ex: Molho da Casa (base=100ml) -> Alho: 0.020 (kg, = 20g).
model ProductionRecipeItem {
  id String @id @default(uuid())

  productionItemId String
  productionItem   ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  quantidade Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productionItemId, stockItemId])
  @@index([stockItemId])
}

// Ledger de entradas/saídas do estoque de UM ProductionItem — mesmo
// espírito de StockMovement. sourceRef segue a mesma convenção
// (idempotência de replay), ex: "venda:<productSalesImportId>:item:<id>".
model ProductionMovement {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productionItemId String
  productionItem   ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Cascade)

  tipo ProductionMovementType

  quantidade Decimal @db.Decimal(12, 3)
  sourceRef  String?
  observacao String?

  data DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("ProductionMovementCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([storeId, sourceRef])
  @@index([storeId])
  @@index([productionItemId])
}

// Dados sensíveis (folha de pagamento) — acesso restrito a
// ADMINISTRATIVO/PROPRIETARIO tanto no backend (RolesGuard) quanto na aba
// do frontend.
//
// Os campos de recorrência (advance*/payment*/vt*/bonus*) descrevem a regra
// fixa de pagamento do funcionário (valor + dia do mês). A partir deles o
// sistema gera automaticamente os lançamentos (EmployeePayment) de cada mês
// — o mesmo princípio das Contas a Pagar, mas com a origem do valor sendo o
// cadastro do funcionário em vez de uma compra.
model Employee {
  id    String  @id @default(uuid())
  name  String
  cpf   String?
  role  String? // cargo/função
  phone String?

  admissionDate DateTime?
  active        Boolean   @default(true)

  notes String?

  salary Decimal? @db.Decimal(10, 2) // salário base, só informativo

  advanceValue Decimal? @db.Decimal(10, 2) // adiantamento
  advanceDay   Int? // dia do mês, 1-31

  paymentValue Decimal? @db.Decimal(10, 2) // pagamento (complemento do salário)
  paymentDay   Int?

  vtValue Decimal? @db.Decimal(10, 2) // valor de uma passagem; total do dia = vtValue * 2

  bonusValue Decimal? @db.Decimal(10, 2) // premiação
  bonusDay   Int?

  paymentMethod PayoutMethod @default(PIX)
  pixKey        String?
  pixKeyType    PixKeyType?

  storeId     String
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation("EmployeeCreatedBy", fields: [createdById], references: [id])

  payments EmployeePayment[]

  @@index([storeId])
  @@index([name])
}

model EmployeePayment {
  id String @id @default(uuid())

  employeeId String
  type       EmployeePaymentType
  value      Decimal             @db.Decimal(10, 2)

  dueDate DateTime
  paidAt  DateTime?
  status  EmployeePaymentStatus @default(OPEN)

  referenceMonth String? // competência, formato YYYY-MM

  notes          String?
  receiptFileUrl String?

  // Nulo quando o lançamento foi gerado automaticamente pelo sistema a
  // partir da recorrência do funcionário (ninguém "criou" manualmente).
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("EmployeePaymentCreatedBy", fields: [createdById], references: [id])

  // Garante que a geração automática não duplique o mesmo lançamento (um
  // por dia pro vale-transporte, um por mês pros demais tipos recorrentes).
  @@unique([employeeId, type, dueDate])
  @@index([employeeId])
  @@index([dueDate])
  @@index([status])
  @@index([type])
}

// Freelancer é separado de Employee (RH) de propósito: pagamento por
// diária trabalhada, sempre às sextas (Terça a Quinta) e segundas (Sexta a
// Domingo) — não tem salário, vale-transporte, nem os outros campos da
// folha fixa. Também é liberado pro Gerente (RH normal não é).
model Freelancer {
  id                String  @id @default(uuid())
  name              String
  defaultDailyValue Decimal @db.Decimal(10, 2)
  active            Boolean @default(true)

  storeId     String
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation("FreelancerCreatedBy", fields: [createdById], references: [id])

  workDays FreelancerWorkDay[]
  payments FreelancerPayment[]

  @@index([storeId])
  @@index([name])
}

// Um registro por dia efetivamente trabalhado (Terça a Domingo — segunda
// não entra porque é o dia de pagamento do ciclo anterior, não de
// trabalho). `value` só é preenchido quando aquele dia específico foge do
// padrão do cadastro; nulo = usa Freelancer.defaultDailyValue na hora de
// montar o quadro de pagamentos.
model FreelancerWorkDay {
  id           String @id @default(uuid())
  freelancerId String

  date  DateTime // meio-dia UTC, mesmo padrão de datas do projeto
  value Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, date])
  @@index([freelancerId])
  @@index([date])
}

enum FreelancerPaymentGroup {
  SEXTA // paga o que foi trabalhado terça a quinta
  SEGUNDA // paga o que foi trabalhado sexta a domingo
}

// Snapshot congelado de um pagamento confirmado — depois de criado, editar
// os FreelancerWorkDay daquela semana não muda mais o valor aqui. É essa
// tabela que alimenta o relatório (por dia pago ou por freelancer), não um
// recálculo em cima dos dias trabalhados.
model FreelancerPayment {
  id String @id @default(uuid())

  freelancerId String
  storeId      String

  group       FreelancerPaymentGroup
  paymentDate DateTime // a sexta ou a segunda em que foi pago
  totalValue  Decimal                @db.Decimal(10, 2)

  // [{ date: "2026-08-18", value: 100 }, ...] — os dias trabalhados que
  // entraram nesse pagamento, congelados no momento da confirmação.
  workDaysSnapshot Json

  paidAt      DateTime @default(now())
  createdById String

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  store      Store      @relation(fields: [storeId], references: [id])
  createdBy  User       @relation("FreelancerPaymentCreatedBy", fields: [createdById], references: [id])

  @@unique([freelancerId, group, paymentDate])
  @@index([storeId])
  @@index([freelancerId])
  @@index([paymentDate])
}

// Definição da tarefa recorrente (ou ocasional). Não guarda o "feito/não
// feito" em si — isso fica em TaskOccurrence, uma linha por ciclo (dia,
// semana ou mês) que precisa ser confirmada pelo responsável.
model Task {
  id          String         @id @default(uuid())
  title       String
  description String?
  recurrence  TaskRecurrence

  // Só usado quando recurrence = WEEKLY. 0=domingo ... 6=sábado (mesma
  // convenção do JS getUTCDay usada no resto do sistema).
  weekday Int?

  // Só usado quando recurrence = MONTHLY. 1-31 (se o mês não tiver esse
  // dia, cai no último dia do mês).
  dayOfMonth Int?

  // Só usado quando recurrence = ONCE — data única da tarefa ocasional.
  dueDate DateTime?

  storeId      String
  assignedToId String
  createdById  String
  active       Boolean @default(true)

  // Restrição de visibilidade por hierarquia — por padrão uma tarefa é
  // visível pra todo mundo com acesso amplo (Administrativo/Gerente).
  // Proprietário pode restringir a visibilidade dela pro Administrativo
  // e/ou pro Gerente; Administrativo só pode restringir do Gerente pra
  // baixo. Quem é responsável ou criou a tarefa sempre enxerga, mesmo
  // restrita. Gerente/Administrativo não conseguem restringir nada.
  restrictedFromAdministrativo Boolean @default(false)
  restrictedFromGerente        Boolean @default(false)

  // Anexo opcional deixado por quem criou a tarefa (ex: um formulário em
  // branco pra preencher). Diferente do anexo da TaskOccurrence, que é o
  // que quem confirma anexa de volta.
  attachmentUrl  String?
  attachmentName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store            @relation(fields: [storeId], references: [id])
  assignedTo  User             @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy   User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  occurrences TaskOccurrence[]

  @@index([storeId])
  @@index([assignedToId])
}

// Uma ocorrência concreta de uma Task num ciclo específico (o dia, a
// semana ou o mês em questão). É isso que aparece pendente pro
// responsável confirmar, e que vira "Atrasada" se passar da data.
model TaskOccurrence {
  id      String   @id @default(uuid())
  taskId  String
  dueDate DateTime

  status        TaskOccurrenceStatus @default(PENDING)
  confirmedAt   DateTime?
  confirmedById String?

  // Quando e quem cancelou essa ocorrência (ex: não vai rolar hoje por
  // algum motivo) — só quem cria/gerencia tarefas pode cancelar, o
  // responsável não (ele só inicia/conclui a dele).
  cancelledAt   DateTime?
  cancelledById String?

  // Observação e anexo deixados por quem confirmou — opcionais, só quando
  // fizer sentido pra aquela ocorrência específica (ex: "faltou material",
  // com foto do problema).
  notes          String?
  attachmentUrl  String?
  attachmentName String?

  // Evita duplicar alerta de atraso — fica true assim que a notificação de
  // atraso é disparada pra essa ocorrência.
  overdueNotifiedAt DateTime?

  createdAt DateTime @default(now())

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  confirmedBy User? @relation("TaskOccurrenceConfirmedBy", fields: [confirmedById], references: [id])
  cancelledBy User? @relation("TaskOccurrenceCancelledBy", fields: [cancelledById], references: [id])

  whatsappMessages WhatsappOutboundMessage[]

  @@unique([taskId, dueDate])
  @@index([taskId])
  @@index([dueDate])
  @@index([status])
}

// Tipo de aviso mandado por WhatsApp — o campo já deixa pronto pra outros
// avisos (aprovação, alerta etc.) usarem o mesmo mecanismo de
// pergunta/resposta no futuro.
enum WhatsappMessageKind {
  TASK_ASSIGNED
  TASK_OVERDUE
  // Lembrete manual — alguém que gerencia tarefas clicou em "Notificar
  // WhatsApp" no card da ocorrência pra cutucar o responsável na hora,
  // sem esperar o cron de atraso.
  TASK_REMINDER
  // Cotação: link pro fornecedor preencher os preços dos itens.
  QUOTATION_REQUEST
  // Cotação: link pro fornecedor confirmar (clicar OK) o pedido fechado
  // depois de escolhido como vencedor.
  QUOTATION_ORDER_CONFIRMATION
  // Cotação: aviso interno pro time (quem marcou
  // User.notifyQuotationConfirmed) quando o fornecedor confirma o pedido —
  // diferente do QUOTATION_ORDER_CONFIRMATION acima, que vai pro
  // fornecedor.
  QUOTATION_ORDER_CONFIRMED_INTERNAL
  // Convite de boas-vindas com o link único de ativação de conta (criar a
  // primeira senha) — ver módulo account/.
  ACCOUNT_ACTIVATION
  // Link único de "esqueci minha senha", quando a pessoa escolhe receber
  // por WhatsApp em vez de e-mail.
  PASSWORD_RESET
}

// Registro de uma mensagem de WhatsApp mandada pelo sistema, guardado pra
// conseguir interpretar a resposta da pessoa (webhook manda só telefone +
// texto — é aqui que a gente descobre "resposta de quê"). taskOccurrenceId
// é preenchido em TASK_ASSIGNED (aviso de nova tarefa), TASK_OVERDUE (aviso
// de atraso) e TASK_REMINDER (lembrete manual) — os três giram em torno de
// uma ocorrência específica; outros tipos futuros podem precisar de outro
// campo de vínculo.
model WhatsappOutboundMessage {
  id String @id @default(uuid())

  userId String
  phone  String // normalizado (só dígitos, com DDI) no momento do envio
  kind   WhatsappMessageKind

  taskOccurrenceId String?

  // Vínculo de cotação por fornecedor (Fase 3: link de cotação).
  quotationSupplierId String?

  text              String
  providerMessageId String?
  sentAt            DateTime @default(now())

  // Preenchidos quando a pessoa responde e o texto bate com uma ação
  // reconhecida (ex: "iniciar"). Fica null se a mensagem nunca foi
  // respondida ou se a resposta não foi reconhecida.
  respondedAt     DateTime?
  responseText    String?
  respondedAction String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskOccurrence    TaskOccurrence?    @relation(fields: [taskOccurrenceId], references: [id], onDelete: Cascade)
  quotationSupplier QuotationSupplier? @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([taskOccurrenceId])
  @@index([quotationSupplierId])
}

// Registro de perda de produto (quebra, vencimento, etc.) — foto tirada
// na hora + descrição + quantidade, tudo no mesmo registro. Alimenta o
// relatório mensal usado pra montar a NF de perda.
model ProductLoss {
  id          String  @id @default(uuid())
  storeId     String
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unit        String?
  reason      String?
  photoUrl    String

  // Valor unitário opcional — só precisa ser preenchido se a perda for
  // entrar numa NF-e de baixa de estoque (Nota de Débito) mais tarde. Sem
  // valor, a perda continua registrada normalmente, só não pode ser
  // selecionada na hora de montar a nota.
  unitValue Decimal? @db.Decimal(10, 2)

  // NCM do produto (8 dígitos) — opcional, só usado pra montar a NF de
  // perda com o código certo em vez do genérico de fallback.
  ncm String?

  reportedById String
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  // Preenchido quando essa perda entra numa nota de baixa já emitida (ou
  // em rascunho) — evita que a mesma perda seja lançada em duas notas.
  lossNfeId String?

  store      Store    @relation(fields: [storeId], references: [id])
  reportedBy User     @relation("ProductLossReportedBy", fields: [reportedById], references: [id])
  lossNfe    LossNfe? @relation(fields: [lossNfeId], references: [id])

  @@index([storeId])
  @@index([occurredAt])
  @@index([lossNfeId])
}

enum LossNfeStatus {
  RASCUNHO // montada mas ainda não enviada pra Sefaz
  ENVIADA // lote enviado, aguardando retorno
  AUTORIZADA
  REJEITADA
  CANCELADA
}

// NF-e de baixa de estoque por perda (Nota de Débito — finNFe=6,
// tpNFDebito=07, CFOP 5.927 — Ajuste SINIEF 49/2025). Diferente de
// IncomingGoodsNf/OutgoingSalesNf (que só guardam NF-e de terceiros já
// emitidas), esse é o único documento que o próprio GestIA emite —
// por isso guarda o XML assinado inteiro, não só um resumo.
model LossNfe {
  id String @id @default(uuid())

  storeId String

  status LossNfeStatus @default(RASCUNHO)

  // tpAmb da Sefaz: 1 = produção (valor fiscal real), 2 = homologação
  // (teste, sem valor fiscal). Toda emissão nasce em homologação até a
  // loja ter uma série de produção configurada e alguém decidir usar de
  // verdade.
  ambiente Int @default(2)

  serie  Int?
  numero Int?

  chaveAcesso String?
  issueDate   DateTime?

  // Motivo geral da baixa (perecimento, quebra, roubo/furto etc.) — vira
  // o texto de infAdFisco, exigido pelo Ajuste SINIEF 49/2025. Se for
  // roubo/furto, é aqui que entra o número do Boletim de Ocorrência.
  justificativa String

  xmlFileUrl    String? // XML assinado, guardado em disco (mesmo padrão das outras NF-e)
  protocolo     String? // nProt devolvido pela Sefaz quando autorizada
  statusMessage String? // cStat/xMotivo do último retorno, só pra diagnóstico

  // Reforma Tributária (IBS/CBS, Nota Técnica 2025.002) — obrigatório em
  // produção pra Lucro Real/Presumido desde ago/2026. "410" = Imunidade e
  // não incidência (sugestão padrão pra baixa de perda, que não é uma
  // operação comercial de verdade), mas fica editável por nota porque só
  // o contador pode confirmar o enquadramento certo caso a caso — mesma
  // lógica já usada pro CFOP. cClassTrib "410030" = "Estorno de crédito
  // por perecimento/deterioração/roubo/furto/extravio" — único código
  // que a Sefaz aceita combinado com tpNFDebito=07 (regra UB14-70); ver
  // aviso completo em loss-nfe-builder.ts.
  cstIbsCbs  String @default("410")
  cClassTrib String @default("410030")

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store         @relation(fields: [storeId], references: [id])
  createdBy User          @relation("LossNfeCreatedBy", fields: [createdById], references: [id])
  losses    ProductLoss[]

  @@index([storeId])
}

enum DevolucaoNfeStatus {
  RASCUNHO // montada mas ainda não enviada pra Sefaz
  ENVIADA // lote enviado, aguardando retorno
  AUTORIZADA
  REJEITADA
  CANCELADA
}

// NF-e de devolução de mercadoria (finNFe=4) — emitida pela LOJA (que
// recebeu a compra original) DE VOLTA pro fornecedor, referenciando a
// chave de acesso da NF-e de entrada original (refNFe). Diferente da
// LossNfe (nota pra si mesma), aqui emit = a loja e dest = o fornecedor
// da NF original. Suporta devolver só alguns itens (e quantidade
// parcial) de uma NF de entrada com muitos itens — cada linha aqui
// referencia o nItem da nota original.
model DevolucaoNfe {
  id String @id @default(uuid())

  storeId String

  // NF de entrada original que está sendo devolvida (referência pro
  // refNFe do XML) — cada devolução se refere a uma única NF de origem.
  incomingGoodsNfId String
  refChaveAcesso    String // chave de acesso da NF original (44 dígitos)

  status DevolucaoNfeStatus @default(RASCUNHO)

  // tpAmb da Sefaz: 1 = produção, 2 = homologação (teste, sem valor
  // fiscal). Mesma convenção da LossNfe — nasce em homologação até
  // alguém decidir usar de verdade com uma série de produção.
  ambiente Int @default(2)

  serie  Int?
  numero Int?

  chaveAcesso String?
  issueDate   DateTime?

  // Motivo da devolução (produto errado, vencido, avariado, etc.) — vai
  // pro campo de informações complementares do XML.
  motivo String

  xmlFileUrl    String? // XML assinado, guardado em disco (mesmo padrão da LossNfe)
  protocolo     String? // nProt devolvido pela Sefaz quando autorizada
  statusMessage String? // cStat/xMotivo do último retorno, só pra diagnóstico

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store           Store              @relation(fields: [storeId], references: [id])
  incomingGoodsNf IncomingGoodsNf    @relation(fields: [incomingGoodsNfId], references: [id])
  createdBy       User               @relation("DevolucaoNfeCreatedBy", fields: [createdById], references: [id])
  itens           DevolucaoNfeItem[]

  @@index([storeId])
  @@index([incomingGoodsNfId])
}

// Cada linha devolvida — referencia o item (nItem) da NF de entrada
// original, com a quantidade devolvida (pode ser menor que a quantidade
// recebida) e o CFOP calculado pra devolução (derivado do CFOP de
// compra original, com fallback manual quando não há mapeamento).
model DevolucaoNfeItem {
  id String @id @default(uuid())

  devolucaoNfeId String

  // Número do item (nItem) na NF de entrada original — não tem FK
  // porque os itens da NF original não são persistidos à parte, só
  // existem dentro do XML (ver parseFullNfeForView); isso é só uma
  // referência pro registro/exibição.
  nItemOrigem Int

  descricao String
  ncm       String?

  cfopOrigem    String // CFOP do item na NF de compra original
  cfopDevolucao String // CFOP calculado (ou informado manualmente) pra devolução

  quantidade    Decimal @db.Decimal(10, 3)
  unidade       String
  valorUnitario Decimal @db.Decimal(10, 2)
  valorTotal    Decimal @db.Decimal(10, 2)

  devolucaoNfe DevolucaoNfe @relation(fields: [devolucaoNfeId], references: [id], onDelete: Cascade)

  @@index([devolucaoNfeId])
}

model Attachment {
