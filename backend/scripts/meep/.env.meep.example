# Copie esse arquivo pra "scripts/meep/.env.meep" (sem o .example) e
# preencha com os seus dados reais. Esse arquivo NÃO deve ser commitado —
# já está coberto pelo .gitignore (*.env.meep).

# Primary Key (ou Secondary Key) que aparece na aba "Profile" do portal
# https://meep-management.developer.azure-api.net/ depois que o
# administrador Meep criar sua assinatura.
MEEP_SUBSCRIPTION_KEY=""

# Login e senha do PORTAL MEEP (https://portal.meep-app.com/) — não é o
# e-mail/senha que você usou pra criar a conta no Developer Portal.
MEEP_USERNAME=""
MEEP_PASSWORD=""

# Opcional pra esse script de teste: se preenchido, além de gerar o token
# ele já testa uma chamada real (GetSimpleSales) com esse storeId.
MEEP_STORE_ID=""
