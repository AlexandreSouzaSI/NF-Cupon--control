# Copie este arquivo pra ".env" e preencha com valores reais.
# Nunca commite o ".env" de verdade — ele já está no .gitignore.

# String de conexão do Postgres.
# Local (docker-compose): postgresql://postgres:postgres@db:5432/compras_db?schema=public
# Render: cole aqui a "Internal Database URL" do banco criado no Render.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/compras_db?schema=public"

# Segredo usado pra assinar os tokens JWT. Gere um valor forte, por exemplo:
# openssl rand -hex 32
JWT_SECRET="troque_por_um_segredo_forte"

# Porta em que o Nest sobe localmente. Em produção (Render) essa variável é
# injetada automaticamente pela plataforma e essa aqui é ignorada.
PORT=4000

# Chave usada pra criptografar (AES-256-GCM) a senha dos certificados
# digitais das lojas (.pfx). Gere com: openssl rand -hex 32
# Trocar essa chave depois de gerada invalida certificados já salvos.
CERT_ENCRYPTION_KEY="troque_por_uma_chave_gerada_com_openssl_rand_hex_32"

# Chave da OpenAI, usada no lançamento por voz (transcrição + extração).
# Deixe em branco se ainda não for usar esse recurso.
OPENAI_API_KEY=""

# Notificação push do navegador/PWA (fora do app aberto). Gere o par com:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY também precisa ser colada em
# frontend/.env como NEXT_PUBLIC_VAPID_PUBLIC_KEY (é a mesma chave pública
# nos dois lados). Deixe as 3 em branco pra desativar push sem quebrar nada
# — o sino de notificação dentro do app continua funcionando normal.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# E-mail ou URL de contato exigido pelo protocolo Web Push (formato
# "mailto:seuemail@exemplo.com").
VAPID_SUBJECT="mailto:alemourasouza33@gmail.com"

# Notificação por WhatsApp (tarefa nova, etc.). Enquanto nenhum provedor
# real for configurado, o sistema só REGISTRA NO LOG o que mandaria (não
# manda WhatsApp de verdade, mas também não quebra nada). Pra ativar de
# verdade, escolha um provedor e implemente WhatsappProvider em
# backend/src/whatsapp/providers/ (ver whatsapp-provider.interface.ts),
# depois troque o "useClass" em whatsapp.module.ts. Opções pesquisadas:
#   - Z-API (z-api.io): mensalidade fixa (~R$100/mês por número), sem
#     verificação de empresa, mais simples pra começar.
#   - Evolution API (github.com/evolution-foundation/evolution-api):
#     gratuita, mas precisa hospedar você mesmo (mais um serviço rodando).
#   - Meta WhatsApp Cloud API: oficial, sem risco de bloqueio, mas exige
#     verificação de empresa + aprovação de modelo de mensagem antes de
#     mandar a primeira mensagem.
# As variáveis abaixo são um ponto de partida genérico — cada provedor
# real vai pedir credenciais próprias (token, instance id etc.), adicione
# conforme o escolhido.
WHATSAPP_PROVIDER_TOKEN=""

# Protege o endpoint POST /whatsapp/webhook (recebe as respostas que
# chegam no WhatsApp). Gere um valor aleatório, por exemplo:
#   openssl rand -hex 24
# e cadastre o mesmo valor como "?token=" na URL do webhook configurada no
# painel do provedor escolhido. Sem essa variável definida, o webhook fica
# desligado (responde 503) — de propósito, pra nunca ficar aberto sem
# querer.
WHATSAPP_WEBHOOK_TOKEN=""
